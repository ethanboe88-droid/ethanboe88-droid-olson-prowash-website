---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
---
<BaseLayout title="Thanks — we got your request" description="Your request was received. Olson Pro Wash will be in touch shortly." canonical="/thanks" noindex>
  <section class="section">
    <div class="container-x flex min-h-[52vh] flex-col items-center justify-center text-center">
      <span class="grid h-16 w-16 place-items-center rounded-2xl border border-jet/40 bg-jet/10 text-jet-hi shadow-jet-sm"><Icon name="check" class="h-8 w-8" /></span>
      <h1 class="display mt-6 text-[clamp(1.9rem,4.4vw,2.6rem)]">Request received — thank you!</h1>
      <p class="mt-4 max-w-md text-text-dim">We'll review the details and get back to you with an estimate, usually the same day. Need something sooner? Call <a href={SITE.phoneHref} class="text-jet-hi hover:underline">{SITE.phone}</a>.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/gallery" class="btn btn-ghost">See recent work</a>
      </div>
    </div>
  </section>
</BaseLayout>
