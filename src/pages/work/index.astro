---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { SITE } from '../../data/site';
import { breadcrumbLd, webPageLd } from '../../data/schema';

const studies = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout
  title="Our Work — Roof, Gutter & Exterior Case Studies | Olson Pro Wash"
  description="Real Olson Pro Wash projects across Snohomish & King County — the problem, the method, and the before-and-after. Roof soft washing, gutter clean-outs and more."
  canonical="/work"
  keywords="pressure washing before and after Snohomish County, roof cleaning case study Lake Stevens, gutter cleaning results Arlington, Olson Pro Wash projects"
  jsonLd={[
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Our Work', path: '/work' }]),
    webPageLd({
      type: 'CollectionPage',
      name: 'Our Work — Olson Pro Wash',
      description: 'Project case studies across Snohomish & King County, WA — roof cleaning, gutter clean-outs and exterior restoration, with the method and the results.',
      path: '/work',
    }),
  ]}
>
  <PageHero
    eyebrow="Case studies"
    title="The work, <span class='text-jet-grad'>in detail</span>"
    intro="Not just a before-and-after slider — the actual problem on each house, the method we used, and how it came out. Real jobs across Snohomish and King County."
    crumbs={[{ label: 'Our Work' }]}
  />

  <section class="section">
    <div class="container-x">
      <div class="grid gap-6 md:grid-cols-2">
        {studies.map((s, i) => (
          <a href={`/work/${s.slug}`} class="reveal panel lift group flex flex-col overflow-hidden" style={`--reveal-delay:${(i % 2) * 70}ms`}>
            <div class="relative aspect-[16/10] overflow-hidden">
              <Photo src={s.data.image} alt={s.data.imageAlt} width={1400} height={1400}
                     sizes="(min-width: 768px) 560px, 100vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
              <span class="absolute left-4 top-4 rounded-full border border-jet/40 bg-ink/80 px-2.5 py-1 font-display text-[10px] font-semibold uppercase tracking-eyebrow text-jet-hi backdrop-blur">{s.data.service}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-2 text-xs text-text-mute">
                <Icon name="pin" class="h-3.5 w-3.5 text-jet-hi" /> {s.data.city}, {SITE.address.region}
                <span>·</span> {s.data.duration}
              </div>
              <h2 class="mt-3 font-display text-lg font-bold text-text">{s.data.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-text-dim">{s.data.summary}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi">Read the case study <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </div>
          </a>
        ))}
      </div>

      <div class="reveal mt-10 flex flex-wrap gap-2.5">
        <a href="/gallery" class="inline-flex rounded-full border border-hairline px-3.5 py-2 text-sm text-text-dim transition hover:border-jet/60 hover:text-text">Before &amp; after gallery</a>
        <a href="/reviews" class="inline-flex rounded-full border border-hairline px-3.5 py-2 text-sm text-text-dim transition hover:border-jet/60 hover:text-text">Reviews</a>
        <a href="/services" class="inline-flex rounded-full border border-hairline px-3.5 py-2 text-sm text-text-dim transition hover:border-jet/60 hover:text-text">All services</a>
      </div>
    </div>
  </section>

  <CtaBanner heading="Your house could be the next one here" sub={`Free, itemized quotes across Snohomish & King County. Call ${SITE.phone} or send a couple of photos.`} />
</BaseLayout>
