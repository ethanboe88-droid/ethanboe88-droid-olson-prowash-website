---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbLd } from '../../data/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const [featured, ...others] = posts;
---
<BaseLayout
  title="Journal — Pressure Washing & Roof Care Tips for the PNW"
  description="Practical advice on roof cleaning, moss control, soft washing and exterior maintenance for homes and businesses in Lake Stevens and the Puget Sound region."
  canonical="/blog"
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Journal', path: '/blog' }])}
>
  <PageHero
    eyebrow="Journal"
    title="Exterior cleaning, <span class='text-jet-grad'>explained</span>"
    intro="How often to wash, what method your surfaces need, and how to keep Pacific Northwest moss from winning."
    crumbs={[{ label: 'Journal' }]}
  />

  <section class="section">
    <div class="container-x">
      {featured && (
        <a href={`/blog/${featured.slug}`} class="reveal panel lift group grid overflow-hidden lg:grid-cols-2">
          <div class="relative aspect-[16/10] lg:aspect-auto">
            <img src={featured.data.heroImage} alt={featured.data.heroAlt} class="absolute inset-0 h-full w-full object-cover" loading="eager" width="1600" height="900" />
          </div>
          <div class="p-7 sm:p-10">
            <div class="flex items-center gap-3 text-xs text-text-mute">
              <span class="rounded-full border border-jet/40 bg-jet/10 px-2.5 py-1 font-display font-semibold uppercase tracking-eyebrow text-jet-hi">Featured</span>
              <span>{featured.data.category}</span><span>·</span>
              <time datetime={featured.data.pubDate.toISOString()}>{fmt(featured.data.pubDate)}</time>
            </div>
            <h2 class="mt-4 font-display text-2xl font-bold text-text sm:text-3xl">{featured.data.title}</h2>
            <p class="mt-3 text-text-dim">{featured.data.description}</p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi">Read the guide <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
          </div>
        </a>
      )}

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="reveal panel lift group flex flex-col overflow-hidden" style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <div class="relative aspect-[16/10]"><img src={post.data.heroImage} alt={post.data.heroAlt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" width="1600" height="900" /></div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-2 text-xs text-text-mute">
                <span>{post.data.category}</span><span>·</span>
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              </div>
              <h3 class="mt-3 font-display text-lg font-bold text-text">{post.data.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-text-dim">{post.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi">Read more <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner heading="Reading up because your roof needs it?" sub="Skip the research — send photos and we'll tell you exactly what it needs." />
</BaseLayout>
