---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../data/site';
import { breadcrumbLd } from '../../data/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const [featured, ...others] = posts;
---
<BaseLayout
  title={`Journal — Pressure Washing Tips & Guides for ${SITE.areaServed}`}
  description="Practical advice on pressure washing, soft washing and exterior maintenance for homes and businesses in the Lake Stevens area and Snohomish County — from the Olson Pro Wash crew."
  canonical="/blog"
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Journal', path: '/blog' }])}
>
  <PageHero
    kicker="Journal"
    title="Exterior cleaning, <span class='text-gradient'>explained</span>"
    intro="How often to wash, what method your surfaces need, and how to get the most value from a professional clean — written for Pacific Northwest homes."
    crumbs={[{ label: 'Journal' }]}
  />

  <section class="section">
    <div class="container-x">
      {featured && (
        <a href={`/blog/${featured.slug}`} class="card card-hover reveal group grid overflow-hidden lg:grid-cols-2">
          <div class="relative aspect-[16/10] lg:aspect-auto">
            <img src={featured.data.heroImage} alt={featured.data.heroAlt} class="absolute inset-0 h-full w-full object-cover" loading="eager" width="1600" height="900" />
          </div>
          <div class="p-7 sm:p-10">
            <div class="flex items-center gap-3 text-xs text-silver-muted">
              <span class="rounded-full border border-electric/40 bg-electric/10 px-2.5 py-1 font-semibold text-electric-300">Featured</span>
              <span>{featured.data.category}</span>
              <span>·</span>
              <time datetime={featured.data.pubDate.toISOString()}>{fmt(featured.data.pubDate)}</time>
            </div>
            <h2 class="mt-4 font-display text-2xl font-bold text-white sm:text-3xl">{featured.data.title}</h2>
            <p class="mt-3 text-silver">{featured.data.description}</p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-electric-300">
              Read the guide <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
            </span>
          </div>
        </a>
      )}

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="card card-hover reveal group flex flex-col overflow-hidden" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <div class="relative aspect-[16/10]">
              <img src={post.data.heroImage} alt={post.data.heroAlt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" width="1600" height="900" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-2 text-xs text-silver-muted">
                <span>{post.data.category}</span>
                <span>·</span>
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              </div>
              <h3 class="mt-3 font-display text-lg font-bold text-white">{post.data.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-silver">{post.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-electric-300">
                Read more <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <p class="text-silver">No posts yet — add Markdown files to <code class="rounded bg-white/5 px-1">src/content/blog/</code>.</p>
      )}
    </div>
  </section>

  <CtaBanner heading="Reading up because your house needs it?" sub="Skip the research — send photos and we’ll tell you exactly what it needs." />
</BaseLayout>
