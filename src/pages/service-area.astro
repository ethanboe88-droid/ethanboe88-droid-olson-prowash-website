---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JetDivider from '../components/JetDivider.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { CITIES } from '../data/cities';
import { SERVICES } from '../data/services';
import { breadcrumbLd, webPageLd, faqLd } from '../data/schema';

const byCounty = {
  'Snohomish County': CITIES.filter((c) => c.county === 'Snohomish County'),
  'King County': CITIES.filter((c) => c.county === 'King County'),
};
const featuredNames = CITIES.map((c) => c.name);
const alsoServing = SITE.serviceCities.filter((c) => !featuredNames.includes(c));

const areaFaqs = [
  {
    q: 'Do you charge a travel fee?',
    a: `No travel fee inside our core service area — ${featuredNames.join(', ')}. Outside that radius, just ask; we travel for the right project and quote it plainly.`,
  },
  {
    q: 'How far will you travel for a job?',
    a: 'We regularly work a roughly 25-mile radius around Lake Stevens, covering most of Snohomish County and north King County. Larger commercial and recurring jobs, we go further.',
  },
  {
    q: "My town isn't listed — can you still help?",
    a: `Probably. The list is where we work most, not a hard boundary. Call ${SITE.phone} or send photos and we will tell you straight away.`,
  },
];
---
<BaseLayout
  title="Service Area — Pressure Washing & Roof Cleaning Across Snohomish & King County"
  description={`Olson Pro Wash serves ${featuredNames.join(', ')}, WA — roof cleaning, house washing, pressure washing, gutters and landscaping. Local, licensed & insured.`}
  canonical="/service-area"
  keywords="pressure washing near me, roof cleaning Snohomish County, house washing King County, Lake Stevens Everett Marysville Arlington Bothell Kirkland Sammamish Issaquah Bellevue Seattle Granite Falls"
  jsonLd={[
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Service Area', path: '/service-area' }]),
    webPageLd({
      type: 'CollectionPage',
      name: 'Service Area — Olson Pro Wash',
      description: 'Cities and communities served across Snohomish County and North King County, WA.',
      path: '/service-area',
      speakableSelectors: ['h1', 'section:nth-of-type(1) p'],
    }),
    faqLd(areaFaqs),
  ]}
>
  <PageHero
    eyebrow="Service area"
    title="Where we <span class='text-jet-grad'>work</span>"
    intro={`Based in ${SITE.address.locality}, Olson Pro Wash covers ${CITIES.length} core cities across Snohomish County and North King County — every service, same standard, no travel fee inside the area.`}
    crumbs={[{ label: 'Service Area' }]}
  />

  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[1fr_0.85fr]">
      <div class="reveal space-y-4 text-lg leading-relaxed text-text-dim">
        <p>
          Olson Pro Wash is a locally owned exterior cleaning and landscaping company in Lake
          Stevens, Washington. We serve homeowners, HOAs, property managers and commercial
          properties from Arlington and Granite Falls down through the Eastside to Issaquah — roughly
          a 25-mile radius around Lake Stevens.
        </p>
        <p>
          The Puget Sound climate is the reason this business exists: rain, marine humidity and a
          dense evergreen canopy grow moss, algae and lichen on roofs, siding and concrete faster
          than almost anywhere in the country. Pick your city below for the local details.
        </p>
        <p class="text-text">Free, itemized quotes. Most estimates back the same day.</p>
      </div>
      <div class="reveal bezel overflow-hidden rounded-2xl">
        <img src="/images/service-area-map.svg" alt="Map of the Olson Pro Wash service area across Snohomish and King County, Washington" class="aspect-[7/5] w-full object-cover" loading="lazy" width="1400" height="1000" />
      </div>
    </div>
  </section>

  <JetDivider />

  {Object.entries(byCounty).map(([county, cities]) => (
    <section class="section">
      <div class="container-x">
        <SectionHeading eyebrow={county} title={`Serving ${county.replace(' County', '')} County`} />
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {cities.map((c, i) => (
            <a href={`/service-area/${c.slug}`} class="reveal panel lift group p-6" style={`--reveal-delay:${(i % 3) * 60}ms`}>
              <div class="flex items-center gap-2">
                <span class="grid h-9 w-9 place-items-center rounded-lg border border-hairline bg-white/[0.03] text-jet-hi"><Icon name="pin" class="h-5 w-5" /></span>
                <h3 class="font-display text-lg font-bold text-text">{c.name}, WA</h3>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-text-dim">{c.intro}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi">
                {c.name} services <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  {alsoServing.length > 0 && (
    <section class="section pt-0">
      <div class="container-x">
        <p class="font-display text-xs font-semibold uppercase tracking-eyebrow text-text-mute">We also regularly serve</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {alsoServing.map((c) => (
            <li class="rounded-full border border-hairline bg-white/[0.03] px-3.5 py-1.5 text-sm text-text-dim">{c}, {SITE.address.region}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <JetDivider flip />

  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="Every service, everywhere we go" title="What we do across the area" />
      <ul class="mt-10 flex flex-wrap gap-2.5">
        {SERVICES.map((s) => (
          <li>
            <a href={s.detailPage ?? `/services#${s.slug}`} class="inline-flex rounded-full border border-hairline px-3.5 py-1.5 text-sm text-text-dim transition hover:border-jet/60 hover:text-text">{s.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-ink-1/50">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading eyebrow="Area FAQ" title="Coverage, travel & fees" />
      <div class="divide-y divide-hairline overflow-hidden rounded-2xl border border-hairline">
        {areaFaqs.map((item) => (
          <details class="group reveal bg-ink-1" name="areafaq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display text-[15px] font-semibold text-text sm:p-6 [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-hairline text-jet-hi transition-transform duration-300 group-open:rotate-45"><Icon name="plus" class="h-4 w-4" /></span>
            </summary>
            <div class="px-5 pb-6 text-sm leading-relaxed text-text-dim sm:px-6"><p set:html={item.a} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner heading="See your town on the list?" sub="Free, same-day quotes anywhere in the service area." />
</BaseLayout>
