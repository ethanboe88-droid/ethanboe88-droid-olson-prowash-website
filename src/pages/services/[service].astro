---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import JetDivider from '../../components/JetDivider.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { SITE } from '../../data/site';
import { CITIES } from '../../data/cities';
import { SERVICES } from '../../data/services';
import { breadcrumbLd, serviceLd, faqLd, howToLd, webPageLd } from '../../data/schema';

export function getStaticPaths() {
  // gutter-guard-installation has its own hand-built page
  return SERVICES.filter((s) => s.slug !== 'gutter-guard-installation').map((s) => ({
    params: { service: s.slug },
    props: { service: s },
  }));
}

type Props = { service: (typeof SERVICES)[number] };
const { service: s } = Astro.props;

const idx = SERVICES.findIndex((x) => x.slug === s.slug);
const num = String(idx + 1).padStart(2, '0');

const sno = CITIES.filter((c) => c.county === 'Snohomish County');
const king = CITIES.filter((c) => c.county === 'King County');
const groups = [
  { county: 'Snohomish County', cities: sno },
  { county: 'King County', cities: king },
];

const related = SERVICES.filter((x) => x.slug !== s.slug).slice(0, 6);

const title = `${s.title} in Lake Stevens & Snohomish County, ${SITE.address.region}`;
const description = `${s.short} Olson Pro Wash — licensed & insured, serving ${CITIES.length}+ cities across Snohomish & King County. ${s.price}. Free quotes: ${SITE.phone}.`;
const heroTitle = `${s.title}, <span class='text-jet-grad'>${s.edge}</span>`;
---
<BaseLayout
  title={`${title} | ${SITE.name}`}
  description={description}
  canonical={s.detailPage}
  image={s.photo ?? SITE.ogImage}
  keywords={`${s.title.toLowerCase()} Lake Stevens WA, ${s.title.toLowerCase()} Snohomish County, ${s.title.toLowerCase()} King County, ${s.title.toLowerCase()} near me, Olson Pro Wash`}
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services' },
      { name: s.title, path: s.detailPage },
    ]),
    webPageLd({
      name: title,
      description,
      path: s.detailPage,
      image: s.photo ?? SITE.ogImage,
      speakableSelectors: ['h1', 'section:nth-of-type(1) p'],
    }),
    serviceLd(s),
    howToLd({
      name: `How Olson Pro Wash performs ${s.title.toLowerCase()}`,
      description: s.short,
      path: s.detailPage,
      steps: s.process.map((st) => ({ name: st.t, text: st.d })),
    }),
    faqLd(s.faqs),
  ]}
>
  <PageHero
    eyebrow={`Service · ${num}`}
    title={heroTitle}
    intro={s.short}
    crumbs={[{ label: 'Services', href: '/services' }, { label: s.title }]}
  />

  <!-- Intro + media -->
  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <SectionHeading eyebrow="What it is" title={`${s.title} — done properly`} class="!max-w-none" />
        <p class="mt-6 text-lg leading-relaxed text-text-dim">{s.description}</p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/contact#quote" data-magnetic class="btn btn-primary">Get a Free Quote <Icon name="arrow" class="h-4 w-4" /></a>
          <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="phone" class="h-4 w-4" /> {SITE.phone}</a>
          <span class="font-display text-xs font-semibold uppercase tracking-eyebrow text-text-mute">{s.price}</span>
        </div>
      </div>

      <div class="reveal">
        {s.slug === 'roof-cleaning' ? (
          <BeforeAfter before="/images/roof-before.jpg" after="/images/roof-after.jpg" start={54}
            label="Roof soft wash — before / after"
            beforeAlt="Mossy, streaked roof before soft washing" afterAlt="The same roof after an Olson Pro Wash soft wash" />
        ) : s.photo ? (
          <figure class="bezel overflow-hidden rounded-2xl bg-ink-2">
            <Photo src={s.photo} alt={s.photoAlt ?? `${s.title} by Olson Pro Wash`} width={1500} height={1000}
                   sizes="(min-width: 1024px) 560px, 100vw" class="aspect-[3/2] w-full object-cover" />
            <figcaption class="border-t border-hairline px-4 py-3 text-xs text-text-mute">{s.title} · Snohomish County, {SITE.address.region}</figcaption>
          </figure>
        ) : (
          <div class="bezel relative grid aspect-[3/2] place-items-center overflow-hidden rounded-2xl bg-ink-2 text-center">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.12]" style="background: var(--jet-gradient); background-size: 220% 100%;"></div>
            <div class="relative">
              <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={s.icon} class="h-7 w-7" /></span>
              <p class="mt-4 font-display text-sm font-semibold uppercase tracking-eyebrow text-text-mute">{s.title}</p>
              <p class="mt-1 text-xs text-text-mute">Project photos coming soon</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <JetDivider />

  <!-- Why it matters here -->
  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading eyebrow="Why it matters here" title={`What ${s.title.toLowerCase()} is up against in the Northwest`} />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {s.whyLocal.map((p, i) => (
          <div class="reveal panel p-6 sm:p-7" style={`--reveal-delay:${i * 70}ms`}>
            <span class="grid h-10 w-10 place-items-center rounded-lg border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={p.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-[15px] font-bold text-text">{p.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-dim">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="What's included" title="Every job, every time" />
      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {s.benefits.map((b, i) => (
          <li class="reveal panel flex items-start gap-3 p-4 text-sm text-text" style={`--reveal-delay:${i * 45}ms`}>
            <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-jet-hi" /><span set:html={b} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading eyebrow="How it works" title="Four steps, <span class='text-jet-grad'>no surprises</span>" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {s.process.map((st, i) => (
          <div id={`step-${i + 1}`} class="reveal panel scroll-mt-28 p-6" style={`--reveal-delay:${i * 70}ms`}>
            <div class="font-display text-2xl font-extrabold text-jet/40">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-3 font-display text-lg font-bold text-text">{st.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-dim">{st.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing note -->
  <section class="section">
    <div class="container-x">
      <div class="reveal panel grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <span class="eyebrow">What it costs</span>
          <p class="mt-3 max-w-2xl text-lg leading-relaxed text-text-dim">{s.priceNote}</p>
        </div>
        <a href="/contact#quote" class="btn btn-primary w-full lg:w-auto">Get my exact number <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <JetDivider flip />

  <!-- Available in every city we serve -->
  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading
        eyebrow="Service area"
        title={`${s.title} in every city we serve`}
        intro={`Same crew, same standard, no travel fee inside the area. Pick your city for local notes on ${s.title.toLowerCase()} — conditions, neighborhoods and a free quote.`}
      />
      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        {groups.map((g) => (
          <div class="reveal">
            <p class="font-display text-xs font-semibold uppercase tracking-eyebrow text-text-mute">{g.county}</p>
            <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
              {g.cities.map((c) => (
                <li>
                  <a href={`/service-area/${c.slug}`}
                     class="group flex items-center justify-between gap-2 rounded-xl border border-hairline bg-white/[0.02] px-3.5 py-2.5 text-sm text-text-dim transition hover:border-jet/60 hover:text-text">
                    <span>{s.title} in <span class="text-text">{c.name}</span>, {SITE.address.region}</span>
                    <Icon name="arrow" class="h-3.5 w-3.5 shrink-0 opacity-60 transition-transform group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-8">
        <a href="/service-area" class="inline-flex items-center gap-1.5 rounded-full border border-jet/40 bg-jet/10 px-3.5 py-2 text-sm text-jet-hi transition hover:border-jet/60">
          See the full service area <Icon name="arrow" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="More from Olson Pro Wash" title="One crew for the whole property" />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r, i) => (
          <a href={r.detailPage} class="reveal panel lift group flex items-start gap-4 p-5" style={`--reveal-delay:${(i % 3) * 55}ms`}>
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi group-hover:text-text"><Icon name={r.icon} class="h-5 w-5" /></span>
            <span class="min-w-0">
              <span class="block font-display text-sm font-bold text-text">{r.title}</span>
              <span class="mt-0.5 block text-xs leading-relaxed text-text-dim">{r.short}</span>
              <span class="mt-1.5 block font-display text-[11px] font-semibold uppercase tracking-eyebrow text-text-mute">{r.price}</span>
            </span>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/services" class="link-underline text-sm font-semibold text-jet-hi">All services <Icon name="arrow" class="inline h-3.5 w-3.5" /></a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-ink-1/50">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading eyebrow={`${s.title} FAQ`} title="Before you book" />
      <Faq items={s.faqs} />
    </div>
  </section>

  <CtaBanner
    heading={`Ready for ${s.title.toLowerCase()} that actually lasts?`}
    sub={`Free, itemized quotes across ${CITIES.length}+ cities in Snohomish & King County. Most estimates back the same day.`}
  />
</BaseLayout>
