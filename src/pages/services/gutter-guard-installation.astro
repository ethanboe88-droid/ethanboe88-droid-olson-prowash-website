---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Faq from '../../components/Faq.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import JetDivider from '../../components/JetDivider.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { SITE } from '../../data/site';
import { getService } from '../../data/services';
import { breadcrumbLd, serviceLd, faqLd, howToLd, webPageLd } from '../../data/schema';

const svc = getService('gutter-guard-installation')!;

const problems = [
  { icon: 'leaf', t: 'Conifer country', d: 'Fir and cedar needles are fine enough to slip through screens and pack a trough solid — twice a year, every year.' },
  { icon: 'drop', t: 'Overflow damage', d: 'A clogged gutter dumps water down the fascia and against the foundation. Rot, mold and settling follow.' },
  { icon: 'roof', t: 'Moss & grit', d: 'Roof grit and moss debris wash straight into open gutters and cement into a sludge that screens can’t stop.' },
  { icon: 'clock', t: 'Ladder season', d: 'Nobody wants to be on a wet ladder in November. Guards end the cleaning cycle for good.' },
];

const system = [
  { t: 'Type 304 stainless micro-mesh', d: 'Raptor uses a corrosion-proof Type 304 stainless steel mesh with roughly 900 openings per square inch — fine enough to stop fir needles, seed pods, shingle grit and pollen, open enough to pass every drop of rain.' },
  { t: 'Patented V-bend on an aluminum frame', d: 'A raised V-bend runs the length of every panel. It stiffens the mesh so it carries snow load without sagging, and it keeps leaves and debris from lying flat and sticking.' },
  { t: 'Trough front lip, fitted to your roofline', d: 'Raptor\'s patented front trough pulls water off the mesh and into the gutter instead of letting it sheet over the edge. Panels are trimmed to the roofline and fastened with Raptor\'s stainless self-tapping screws.' },
];

const raptorSpecs = [
  { k: 'Mesh material', v: 'Type 304 stainless steel' },
  { k: 'Mesh density', v: '~900 openings per square inch' },
  { k: 'Frame', v: 'Aluminum, patented V-bend' },
  { k: 'Fasteners', v: 'Stainless self-tapping screws (no staples or adhesive)' },
  { k: 'Fits', v: 'Most existing 5", 6" and 7" gutters' },
  { k: 'Fire', v: 'Slows flame spread by 30+ minutes' },
  { k: 'Warranty', v: '25-year Raptor manufacturer warranty' },
  { k: 'Materials', v: '100% recyclable — no plastic or PVC' },
];

const steps = [
  { n: '01', t: 'Assess & measure', d: 'We check gutter condition, pitch, fascia and downspouts, and measure every run. Rotten sections are flagged before we quote.' },
  { n: '02', t: 'Clean & re-pitch', d: 'Existing gutters are hand-cleared, flushed, re-sealed at the seams and re-pitched to the downspouts so they actually drain.' },
  { n: '03', t: 'Install the Raptor guard', d: 'Panels are cut to length, lapped at the seams and fastened with Raptor\'s stainless self-tapping screws, trimmed into the roofline — no staples, no adhesive-only installs.' },
  { n: '04', t: 'Flow test & clean-up', d: 'We run water across every section, confirm full flow through the downspouts, and haul away every scrap.' },
];

const compare = [
  ['Fine fir needles & grit', 'Passes straight through', 'Mostly blocked', 'Blocked — ~900 openings/in²'],
  ['Heavy PNW rain (flow rate)', 'Full — until it clogs', 'Reduced by foam', 'Full — trough pulls water in'],
  ['Snow / ice load', 'N/A', 'Can crush', 'V-bend holds shape'],
  ['Corrosion over 10+ yrs', 'N/A', 'Rusts, discolors', '304 stainless — rustproof'],
  ['Re-cleaning needed', 'Twice a year', 'Yearly', 'Rare rinse only'],
  ['Warranty', 'None', 'Varies', '25-year manufacturer'],
];

const faqs = [
  {
    q: 'Which gutter guard do you install?',
    a: 'Raptor contractor-grade stainless steel micro-mesh — a Type 304 stainless mesh with roughly 900 openings per square inch, set on an aluminum frame with a patented V-bend and front trough. It is the format that actually holds up to fir needles and roof grit in the Pacific Northwest.',
  },
  {
    q: 'Do I still need to have my gutters cleaned after guards are installed?',
    a: 'Almost never. Fine dust and pollen can build a thin film on top of the mesh over several years — a quick rinse from a ladder or a <a href="/services/gutter-cleaning">soft wash</a> clears it. You will not be scooping needles out again.',
  },
  {
    q: 'Will Raptor micro-mesh keep up with a Pacific Northwest downpour?',
    a: 'Yes. The mesh has far more open area than the gutter can carry, and Raptor\'s patented trough pulls water off the surface and into the gutter rather than letting it skate over the front. Reverse-curve and foam systems are the ones that struggle with our rain — micro-mesh does not.',
  },
  {
    q: 'Is it really stainless steel? Will it rust near saltwater?',
    a: 'The mesh is Type 304 stainless steel, which is highly corrosion resistant, and the screws are stainless too. Type 304 handles Puget Sound marine air well. Very close to open saltwater the manufacturer adjusts the warranty term — we will confirm the exact coverage for your address before you book.',
  },
  {
    q: 'Does it work with a moss-prone roof or a metal roof?',
    a: 'Yes on both. On shingle roofs we recommend pairing it with a <a href="/services/roof-cleaning">roof soft wash</a> so you are not sending years of moss debris onto fresh guards. On metal and standing-seam roofs we fasten Raptor appropriately to the gutter and fascia without penetrating the roofing.',
  },
  {
    q: 'What is the warranty?',
    a: 'Raptor backs the guard with a 25-year manufacturer warranty, and Olson Pro Wash backs the installation workmanship. If water gets past a section we installed, we come back and fix it.',
  },
  {
    q: 'Can you use my existing gutters, or do I need new ones?',
    a: 'If your gutters are structurally sound we clean, re-seal and re-pitch them and fit Raptor to what you have — it is sized for standard 5", 6" and 7" gutters. If sections are rusted through or pulling off the fascia we will show you photos and quote replacement separately, no surprises.',
  },
];

const priceRanges = [
  { t: 'Single-story home', d: '120–180 linear ft', p: '$960 – $1,650' },
  { t: 'Two-story home', d: '180–260 linear ft', p: '$1,650 – $2,400' },
  { t: 'Add-on to a wash', d: 'Bundled with roof / house wash', p: 'Discounted rate' },
];
---
<BaseLayout
  title="Raptor Gutter Guard Installation in Lake Stevens, WA — Stainless Micro-Mesh"
  description="Olson Pro Wash installs Raptor Type 304 stainless steel micro-mesh gutter guards across Snohomish & King County. Gutters cleaned and re-pitched first. 25-year warranty. From $8/ft."
  canonical="/services/gutter-guard-installation"
  keywords="Raptor gutter guard installation Lake Stevens WA, stainless steel micro-mesh gutter guards, Raptor gutter guard installer Snohomish County, stop cleaning gutters, fir needle gutter guard, 304 stainless gutter guard"
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services' },
      { name: 'Gutter Guard Installation', path: '/services/gutter-guard-installation' },
    ]),
    webPageLd({
      name: 'Raptor Gutter Guard Installation in Lake Stevens, WA',
      description: 'Professional installation of Raptor Type 304 stainless steel micro-mesh gutter guards across Snohomish & King County.',
      path: '/services/gutter-guard-installation',
      image: '/images/p-gutterguard.jpg',
      speakableSelectors: ['h1', 'section:nth-of-type(1) p'],
    }),
    serviceLd(svc),
    howToLd({
      name: 'How Olson Pro Wash installs Raptor gutter guards',
      description: 'Assess, clean and re-pitch the gutters, install the Raptor stainless micro-mesh guard, then flow-test — in one visit.',
      path: '/services/gutter-guard-installation',
      steps: steps.map((s) => ({ name: s.t, text: s.d })),
    }),
    faqLd(faqs),
  ]}
>
  <PageHero
    eyebrow="Service · Gutter protection"
    title="Raptor gutter guards, <span class='text-jet-grad'>installed right</span>"
    intro={svc.short}
    crumbs={[{ label: 'Services', href: '/services' }, { label: 'Gutter Guard Installation' }]}
  />

  <!-- Intro + before/after -->
  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <SectionHeading eyebrow="Why it matters here" title="Open gutters lose in the Northwest" class="!max-w-none" />
        <p class="mt-6 text-lg leading-relaxed text-text-dim">{svc.description}</p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/contact#quote" data-magnetic class="btn btn-primary">Get a Free Quote <Icon name="arrow" class="h-4 w-4" /></a>
          <span class="font-display text-xs font-semibold uppercase tracking-eyebrow text-text-mute">{svc.price}</span>
        </div>
      </div>
      <figure class="reveal bezel overflow-hidden rounded-2xl bg-ink-2">
        <Photo src="/images/p-gutterguard.jpg" alt="Ethan Olson fitting a Raptor stainless steel micro-mesh gutter guard on a shingle roof"
               width={1500} height={1000} sizes="(min-width: 1024px) 560px, 100vw" class="aspect-[3/2] w-full object-cover" />
        <figcaption class="border-t border-hairline px-4 py-3 text-xs text-text-mute">Raptor stainless micro-mesh, fitted to the roofline · Snohomish County</figcaption>
      </figure>
    </div>
  </section>

  <JetDivider />

  <!-- The problem -->
  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading eyebrow="The problem" title="What clogged gutters actually cost you" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {problems.map((p, i) => (
          <div class="reveal panel p-6" style={`--reveal-delay:${i * 65}ms`}>
            <span class="grid h-10 w-10 place-items-center rounded-lg border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={p.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-[15px] font-bold text-text">{p.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-dim">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The system -->
  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="What we install" title="Raptor: not a screen, a <span class='text-jet-grad'>filter</span>." intro="Foam inserts break down and reverse-curve systems overshoot in heavy rain. We install Raptor contractor-grade stainless steel micro-mesh — the format that actually holds up in fir country." />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {system.map((s, i) => (
          <div class="reveal panel p-6 sm:p-7" style={`--reveal-delay:${i * 70}ms`}>
            <div class="font-display text-2xl font-extrabold text-jet/40">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-3 font-display text-lg font-bold text-text">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-dim">{s.d}</p>
          </div>
        ))}
      </div>

      <div class="reveal panel mt-8 p-6 sm:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="font-display text-lg font-bold text-text">Raptor stainless micro-mesh — the spec</h3>
          <span class="font-display text-xs font-semibold uppercase tracking-eyebrow text-text-mute">Contractor grade</span>
        </div>
        <dl class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {raptorSpecs.map((s) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-hairline pb-2.5">
              <dt class="text-sm text-text-mute">{s.k}</dt>
              <dd class="text-right font-display text-sm font-semibold text-text">{s.v}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-5 text-xs text-text-mute">
          Raptor is contractor-grade micro-mesh sold for professional and DIY install. We fit and finish it to a
          Northwest roofline — cleaned, sealed and re-pitched gutters first, then panels lapped and screwed, never stapled.
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading eyebrow="How it compares" title="Open gutter vs. screen/foam vs. Raptor micro-mesh" />
      <div class="reveal mt-10 overflow-x-auto rounded-2xl border border-hairline">
        <table class="w-full min-w-[640px] text-sm">
          <thead>
            <tr class="bg-ink-2 text-left font-display uppercase tracking-eyebrow text-text-mute">
              <th class="p-4 font-semibold"> </th>
              <th class="p-4 font-semibold">Open gutter</th>
              <th class="p-4 font-semibold">Screen / foam</th>
              <th class="p-4 font-semibold text-jet-hi">Raptor micro-mesh</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {compare.map((row) => (
              <tr>
                <td class="p-4 font-medium text-text">{row[0]}</td>
                <td class="p-4 text-text-dim">{row[1]}</td>
                <td class="p-4 text-text-dim">{row[2]}</td>
                <td class="p-4 font-medium text-text">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="How it works" title="Four steps, <span class='text-jet-grad'>one visit</span>" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <div id={`step-${i + 1}`} class="reveal panel scroll-mt-28 p-6" style={`--reveal-delay:${i * 70}ms`}>
            <div class="font-display text-2xl font-extrabold text-jet/40">{s.n}</div>
            <h3 class="mt-3 font-display text-lg font-bold text-text">{s.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-dim">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits + pricing -->
  <section class="section bg-ink-1/50">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_0.9fr]">
      <div>
        <SectionHeading eyebrow="What you get" title="Climb the ladder once — for the install" />
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {svc.benefits.map((b, i) => (
            <li class="reveal panel flex items-start gap-3 p-4 text-sm text-text" style={`--reveal-delay:${i * 45}ms`}>
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-jet-hi" /><span set:html={b} />
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal panel p-6 sm:p-7">
        <span class="eyebrow">Ballpark pricing</span>
        <p class="mt-3 text-sm text-text-dim">Priced by the linear foot ({svc.price}), quoted firm after a measure. Typical ranges:</p>
        <ul class="mt-4 divide-y divide-hairline">
          {priceRanges.map((r) => (
            <li class="flex items-center justify-between gap-4 py-3">
              <span><span class="block font-display text-sm font-semibold text-text">{r.t}</span><span class="text-xs text-text-mute">{r.d}</span></span>
              <span class="shrink-0 font-display text-sm font-bold tabular-nums text-jet-hi">{r.p}</span>
            </li>
          ))}
        </ul>
        <a href="/contact#quote" class="btn btn-primary mt-5 w-full text-sm">Get my exact number <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <SectionHeading eyebrow="Gutter guard FAQ" title="Before you book" />
        <div class="mt-6 flex flex-col gap-2.5 text-sm">
          <a href="/faq/gutter-guards" class="inline-flex items-center gap-1.5 font-semibold text-jet-hi link-underline">Full gutter guard FAQ <Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/blog/raptor-gutter-guards-pacific-northwest" class="inline-flex items-center gap-1.5 font-semibold text-jet-hi link-underline">Why we chose Raptor for the PNW <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBanner heading="Done cleaning gutters twice a year?" sub="Free measure and a firm per-foot quote on Raptor. Bundles with a roof or house wash for a lower rate." />
</BaseLayout>
