---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { breadcrumbLd } from '../data/schema';

const shots = [
  { src: '/images/p-roof.jpg', cat: 'Roof Cleaning', alt: 'Olson Pro Wash technician soft-washing a roof from the ridge' },
  { src: '/images/p-house-truck.jpg', cat: 'House Washing', alt: 'Soft-washing a large two-story home with the Olson Pro Wash rig alongside' },
  { src: '/images/p-driveway.jpg', cat: 'Pressure Washing', alt: 'Running a rotary surface cleaner on a residential driveway' },
  { src: '/images/p-gutterguard.jpg', cat: 'Gutter Guards', alt: 'Fitting a stainless micro-mesh gutter guard on a shingle roof' },
  { src: '/images/p-roof2.jpg', cat: 'Roof Cleaning', alt: 'Ethan Olson soft-washing a mossy roof from a ladder' },
  { src: '/images/p-deck.jpg', cat: 'Decks', alt: 'Soft-washing a composite deck, foam on the boards' },
  { src: '/images/p-fence.jpg', cat: 'Soft Washing', alt: 'Soft-washing a wood privacy fence' },
  { src: '/images/p-gutter.jpg', cat: 'Gutters', alt: 'Clearing debris from a home gutter by hand' },
  { src: '/images/p-window.jpg', cat: 'Window Cleaning', alt: 'Squeegeeing an exterior window from a ladder' },
  { src: '/images/p-house.jpg', cat: 'House Washing', alt: 'Technician soft-washing a two-story home, suds running down the siding' },
];
---
<BaseLayout
  title="Gallery — Before & After Roof Cleaning & Pressure Washing"
  description="Before-and-after photos of roof soft washing, house washing, driveway cleaning, deck restoration and landscaping across Lake Stevens, Snohomish & King County, WA."
  canonical="/gallery"
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Gallery', path: '/gallery' }])}
>
  <PageHero
    eyebrow="Gallery"
    title="Proof, not <span class='text-jet-grad'>promises</span>"
    intro="Drag the sliders. Open the grid. This is the standard every Olson Pro Wash job is held to."
    crumbs={[{ label: 'Gallery' }]}
  />

  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="Before / after" title="Move the handle" />
      <div class="mt-10">
        <BeforeAfter class="reveal" before="/images/roof-before.jpg" after="/images/roof-after.jpg" start="54"
          label="Roof soft wash · Snohomish County, WA" beforeAlt="Mossy, streaked roof before soft washing" afterAlt="The same roof after soft washing" />
      </div>
    </div>
  </section>

  <section class="section bg-ink-1/50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Project grid" title="Recent work around the region" />
      </div>
      <div class="mt-10"><GalleryGrid shots={shots} /></div>
      <p class="mt-6 text-sm text-text-mute reveal">Photos are branded placeholders — replace the files in <code class="rounded bg-white/5 px-1">public/images/</code> with real project shots.</p>
    </div>
  </section>

  <CtaBanner heading="Want your project in this gallery?" />
</BaseLayout>
