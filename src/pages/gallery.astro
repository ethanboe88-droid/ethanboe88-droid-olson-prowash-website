---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { breadcrumbLd } from '../data/schema';

const shots = [
  { src: '/images/gallery-1.svg', cat: 'Roof Cleaning', alt: 'Roof after a full moss soft wash, streaks removed' },
  { src: '/images/gallery-2.svg', cat: 'House Washing', alt: 'Two-story home after an exterior soft wash' },
  { src: '/images/gallery-3.svg', cat: 'Driveways', alt: 'Concrete driveway after surface cleaning' },
  { src: '/images/gallery-4.svg', cat: 'Commercial', alt: 'Storefront sidewalk and entrance cleaned' },
  { src: '/images/gallery-5.svg', cat: 'Roof Cleaning', alt: 'Lakeside home roof brightened after soft wash' },
  { src: '/images/gallery-6.svg', cat: 'Decks', alt: 'Restored cedar deck and railings' },
  { src: '/images/gallery-7.svg', cat: 'Landscaping', alt: 'Mulched beds and trimmed shrubs after clean-up' },
  { src: '/images/gallery-8.svg', cat: 'Gutters', alt: 'Gutter line cleared and faces soft washed' },
  { src: '/images/gallery-9.svg', cat: 'Commercial', alt: 'Dumpster pad and back entry pressure washed' },
];
---
<BaseLayout
  title="Gallery — Before & After Roof Cleaning & Pressure Washing"
  description="Before-and-after photos of roof soft washing, house washing, driveway cleaning, deck restoration and landscaping across Lake Stevens, Snohomish & King County, WA."
  canonical="/gallery"
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Gallery', path: '/gallery' }])}
>
  <PageHero
    eyebrow="Gallery"
    title="Proof, not <span class='text-jet-grad'>promises</span>"
    intro="Drag the sliders. Open the grid. This is the standard every Olson Pro Wash job is held to."
    crumbs={[{ label: 'Gallery' }]}
  />

  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="Before / after" title="Move the handle" />
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <BeforeAfter class="reveal" before="/images/before-1.svg" after="/images/after-1.svg" label="Roof soft wash · Lake Stevens, WA" beforeAlt="Mossy roof before" afterAlt="Clean roof after" />
        <BeforeAfter class="reveal" before="/images/before-2.svg" after="/images/after-2.svg" start="48" label="House wash · Everett, WA" beforeAlt="Algae siding before" afterAlt="Clean siding after" />
        <BeforeAfter class="reveal lg:col-span-2" before="/images/before-3.svg" after="/images/after-3.svg" start="58" label="Driveway · Marysville, WA" beforeAlt="Stained driveway before" afterAlt="Clean driveway after" />
      </div>
    </div>
  </section>

  <section class="section bg-ink-1/50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Project grid" title="Recent work around the region" />
      </div>
      <div class="mt-10"><GalleryGrid shots={shots} /></div>
      <p class="mt-6 text-sm text-text-mute reveal">Photos are branded placeholders — replace the files in <code class="rounded bg-white/5 px-1">public/images/</code> with real project shots.</p>
    </div>
  </section>

  <CtaBanner heading="Want your project in this gallery?" />
</BaseLayout>
