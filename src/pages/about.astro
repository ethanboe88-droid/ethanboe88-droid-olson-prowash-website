---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatStrip from '../components/StatStrip.astro';
import CtaBanner from '../components/CtaBanner.astro';
import JetDivider from '../components/JetDivider.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { SITE } from '../data/site';
import { breadcrumbLd, personLd, webPageLd } from '../data/schema';

const milestones = [
  {
    year: 'Age 13',
    t: 'A bike and a homemade trailer',
    d: 'Built a trailer, bolted it to the back of my electric bike, and started mowing lawns around the neighborhood. A real business — just a small one.',
  },
  {
    year: 'Age 16',
    t: 'Made it official',
    d: 'Licensed, bonded and insured, done the right way. Around the same time we shifted the focus to exterior cleaning.',
  },
  {
    year: 'Today',
    t: 'Olson Pro Wash',
    d: 'Roof & soft washing, hot-water pressure washing and landscaping across Snohomish & King County. Same owner on the job site.',
  },
];

const values = [
  { icon: 'check', t: 'Honest work', d: 'Straight scope, straight pricing, straight timelines. The number I quote is the number you pay.' },
  { icon: 'drop', t: 'Method over muscle', d: 'The right detergent and dwell time beat brute pressure every time — deeper clean, zero damage.' },
  { icon: 'shield', t: 'Show up like a pro', d: 'On time, in uniform, in a clean truck, with the paperwork you asked for. Every visit.' },
  { icon: 'leaf', t: 'Leave it better', d: 'Landscaping protected, walkways rinsed, nothing left behind but a cleaner property.' },
];
---
<BaseLayout
  title={`About ${SITE.name} — Meet Ethan Olson`}
  description={`Olson Pro Wash is owner-operated by Ethan Olson, born and raised in Marysville and Lake Stevens, WA. Licensed and insured, serving Snohomish & King County since ${SITE.founded}.`}
  canonical="/about"
  jsonLd={[
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }]),
    webPageLd({
      type: 'AboutPage',
      name: `About ${SITE.name} — Meet Ethan Olson`,
      description: `Olson Pro Wash is owner-operated by Ethan Olson, serving Snohomish & King County since ${SITE.founded}.`,
      path: '/about',
      image: '/images/founder.jpg',
      speakableSelectors: ['h1', 'section:nth-of-type(1) p'],
    }),
    personLd,
  ]}
>
  <PageHero
    eyebrow="About · Meet the owner"
    title="Started at 13 with a bike and a <span class='text-jet-grad'>homemade trailer</span>."
    intro="Olson Pro Wash is owner-operated by Ethan Olson — born and raised between Marysville and Lake Stevens, and never far from home since."
    crumbs={[{ label: 'About' }]}
  />

  <!-- Founder + photo -->
  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="reveal space-y-4 text-lg leading-relaxed text-text-dim">
        <SectionHeading eyebrow="Our story" title="Born here. Built here. Still here." class="!max-w-none" />
        <p class="mt-6">
          My name is Ethan Olson, and I've never really lived anywhere else. I grew up between
          Marysville and Lake Stevens and graduated from Lake Stevens High School — the same streets
          I now run a work truck down every week.
        </p>
        <p>
          I started young. At 13 I built a little trailer, bolted it to the back of my electric bike,
          and started mowing lawns around the neighborhood. It was a real business, just a small one —
          and it taught me the thing this whole company still runs on: people will hand you their home
          if you show up, do what you said, and treat it like it's your own.
        </p>
        <p>
          At 16 I made it official — licensed, bonded and insured, done the right way. Around the same
          time we shifted the focus to exterior cleaning: pressure washing, roof and soft washing. Olson
          Pro Wash has been that ever since. Same owner. Same standard. A lot more equipment.
        </p>
        <p class="text-text">
          I love Snohomish County, and I love Washington — the evergreens, the lakes, the fact that
          everything grows moss if you leave it alone long enough. You'll catch me at just about every
          community event, at the Planet Fitness in Lake Stevens, training MMA, or on a ladder somewhere
          between here and King County. This is home, and these are my neighbors. That's not a marketing
          line — it's just the job.
        </p>
      </div>

      <div class="reveal">
        <figure class="bezel overflow-hidden rounded-2xl bg-ink-2">
          <Photo src="/images/founder.jpg" alt="Ethan Olson, founder of Olson Pro Wash, Lake Stevens WA"
                 width={1200} height={1500} fullWidth={1200}
                 sizes="(min-width: 1024px) 460px, 100vw" class="aspect-[4/5] w-full object-cover" />
          <figcaption class="flex items-center justify-between border-t border-hairline px-4 py-3 text-xs">
            <span class="font-display font-semibold uppercase tracking-eyebrow text-text">Ethan Olson</span>
            <span class="text-text-mute">Founder · Lake Stevens, WA</span>
          </figcaption>
        </figure>
        <div class="panel mt-4 p-5">
          <div class="flex items-center gap-2 text-sm font-semibold text-text">
            <Icon name="pin" class="h-4 w-4 text-jet-hi" /> Owner-operated, {SITE.address.locality}, {SITE.address.region}
          </div>
          <p class="mt-2 text-sm text-text-dim">Licensed, bonded &amp; insured. Serving {SITE.serviceCities.slice(0, 8).join(' · ')} and nearby.</p>
          <a href="/guarantee" class="link-underline mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi">Read the Olson guarantee <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="section pt-0">
    <div class="container-x">
      <div class="reveal bezel relative overflow-hidden rounded-4xl p-8 text-center sm:p-14">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
          <div class="absolute inset-0 opacity-[0.12]" style="background: var(--jet-gradient); background-size:220% 100%;"></div>
        </div>
        <span class="eyebrow justify-center">Our mission</span>
        <p class="display mx-auto mt-4 max-w-3xl text-[clamp(1.6rem,4vw,2.5rem)]">
          Do honest work, and take care of <span class="text-jet-grad">everybody in our community</span>.
        </p>
      </div>
    </div>
  </section>

  <!-- Milestones -->
  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="The road here" title="From a lawn route to a <span class='text-jet-grad'>pro wash crew</span>" />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {milestones.map((m, i) => (
          <div class="reveal panel p-6 sm:p-7" style={`--reveal-delay:${i * 70}ms`}>
            <div class="font-display text-sm font-semibold uppercase tracking-eyebrow text-jet-hi">{m.year}</div>
            <h3 class="mt-2 font-display text-lg font-bold text-text">{m.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-dim">{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <JetDivider />

  <!-- Stats -->
  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading eyebrow="By the numbers" title="Five years, one standard" class="mb-10" />
      <StatStrip />
    </div>
  </section>

  <!-- Values -->
  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="What we stand for" title="Four rules we <span class='text-jet-grad'>don't bend</span>" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v, i) => (
          <div class="reveal panel p-6" style={`--reveal-delay:${i * 60}ms`}>
            <span class="grid h-11 w-11 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={v.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-lg font-bold text-text">{v.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-dim">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Around town -->
  <section class="section bg-ink-1/50">
    <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <SectionHeading eyebrow="Around town" title="Local isn't a tagline here" intro="I live in this community, not just work in it." />
      <ul class="grid gap-3 sm:grid-cols-2">
        {[
          'Born and raised — Marysville & Lake Stevens',
          'Lake Stevens High School',
          'At just about every local community event',
          'Planet Fitness Lake Stevens regular',
          'Trains MMA locally',
          'Trucks working across Snohomish & King County',
          'Owner on the job site, not just on the invoice',
          'Deep roots in Washington and the Northwest',
        ].map((li, i) => (
          <li class="reveal panel flex items-center gap-3 p-4 text-sm text-text" style={`--reveal-delay:${i * 45}ms`}>
            <Icon name="check" class="h-4 w-4 shrink-0 text-jet-hi" /> {li}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBanner heading="Hire the owner, not a call center" sub="Ethan quotes it, and an Olson crew does the work. Free estimates, same-day." />
</BaseLayout>
