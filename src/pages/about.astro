---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatStrip from '../components/StatStrip.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { breadcrumbLd } from '../data/schema';

const values = [
  { icon: 'drop', t: 'Method over muscle', d: 'The right detergent and dwell time beat brute pressure every time. We clean deeper and cause zero damage.' },
  { icon: 'shield', t: 'Show up like professionals', d: 'On time, in uniform, in a clean truck, with the paperwork you asked for. Every visit.' },
  { icon: 'check', t: 'Say what we’ll do, do what we said', d: 'Honest scope, honest pricing, honest timelines. If something changes, you hear it from us first.' },
  { icon: 'leaf', t: 'Leave it better than we found it', d: 'Landscaping protected, walkways rinsed, nothing left behind but a cleaner property.' },
];

const team = [
  { img: '/images/team-1.svg', name: 'Owner / Field Lead', role: 'Estimates & pressure work', bio: 'Runs every walk-through and dials in pressure, tips and temperature for each surface on site.' },
  { img: '/images/team-2.svg', name: 'Soft Wash Tech', role: 'Roof & house washing', bio: 'Mixes and applies the low-pressure detergent systems and owns the landscape-protection checklist.' },
  { img: '/images/team-3.svg', name: 'Landscape Crew', role: 'Beds, mulch & clean-ups', bio: 'Handles the finish work — edging, mulch, trimming and haul-away — so the whole property lands.' },
];
---
<BaseLayout
  title={`About ${SITE.name} — Locally Owned Exterior Cleaning`}
  description={`Olson Pro Wash is a locally owned, licensed and insured pressure washing and landscaping company based in ${SITE.address.locality}, ${SITE.address.region}, serving Snohomish & King County since ${SITE.founded}.`}
  canonical="/about"
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }])}
>
  <PageHero
    eyebrow="About"
    title="Owner-operated. <span class='text-jet-grad'>Obsessive about the finish.</span>"
    intro={`Founded in ${SITE.founded} and based in ${SITE.address.locality}, Olson Pro Wash grew from a single trailer into a go-to exterior crew for Lake Stevens, Snohomish County and North King County.`}
    crumbs={[{ label: 'About' }]}
  />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="reveal space-y-4 text-lg leading-relaxed text-text-dim">
        <SectionHeading eyebrow="Our story" title="From one trailer to the whole exterior" class="!max-w-none" />
        <p class="mt-6">Olson Pro Wash started the way a lot of Snohomish County businesses do: one person, one trailer, and a belief that most homes and storefronts around here were being cleaned too aggressively — or not at all.</p>
        <p>Early on we watched other outfits scar siding, blow out window seals and strip roof granules with too much pressure. So we went the other direction: we learned soft washing properly, invested in hot-water equipment, and built a prep-and-protect routine we run on every job.</p>
        <p>Homeowners started asking if we could handle the beds and mulch too, since we were already out there making everything else look sharp. That's how the landscaping side was born — and why today one Olson crew can take a property from tired to turnkey in a single visit.</p>
        <p class="text-text">Same owner on the job site. Same phone number. {SITE.areaServedLong}.</p>
      </div>
      <div class="reveal">
        <div class="bezel overflow-hidden rounded-2xl">
          <img src="/images/gallery-3.svg" alt="Olson Pro Wash crew working on a Lake Stevens area property" class="aspect-[4/5] w-full object-cover" loading="lazy" width="1200" height="1500" />
        </div>
        <div class="panel mt-4 p-5">
          <div class="flex items-center gap-2 text-sm font-semibold text-text"><Icon name="pin" class="h-4 w-4 text-jet-hi" /> Based in {SITE.address.locality}, {SITE.address.region}</div>
          <p class="mt-2 text-sm text-text-dim">Serving {SITE.serviceCities.slice(0, 8).join(' · ')} and nearby.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0"><div class="container-x"><StatStrip /></div></section>

  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading eyebrow="What we stand for" title="Four rules we <span class='text-jet-grad'>don't bend</span>" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {values.map((v, i) => (
          <div class="reveal panel p-6 sm:p-7" style={`--reveal-delay:${i * 65}ms`}>
            <span class="grid h-11 w-11 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={v.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-lg font-bold text-text">{v.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-dim">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="The crew" title="Small team. <span class='text-jet-grad'>High standards.</span>" intro="You'll see the same faces from quote to clean-up — not a rotating cast of subcontractors." />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((m, i) => (
          <figure class="reveal panel lift overflow-hidden" style={`--reveal-delay:${i * 75}ms`}>
            <img src={m.img} alt={`${m.name} — ${SITE.name}`} class="aspect-square w-full object-cover" loading="lazy" width="900" height="900" />
            <figcaption class="p-5">
              <div class="font-display text-lg font-bold text-text">{m.name}</div>
              <div class="text-xs uppercase tracking-eyebrow text-jet-hi">{m.role}</div>
              <p class="mt-2 text-sm leading-relaxed text-text-dim">{m.bio}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="reveal mt-6 text-sm text-text-mute">Team titles and photos are placeholders — swap in real names and headshots in <code class="rounded bg-white/5 px-1">src/pages/about.astro</code>.</p>
    </div>
  </section>

  <section class="section bg-ink-1/50">
    <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <SectionHeading eyebrow="Why choose us" title="What you get with Olson that you don't get with a guy and a wand" />
      <ul class="grid gap-3 sm:grid-cols-2">
        {[
          'Written, itemized quotes',
          'Certificate of Insurance on request',
          'Roof soft-wash certified',
          'Hot-water pressure equipment',
          'Landscape protection on every job',
          'Before/after photo documentation',
          'One crew for cleaning + landscaping',
          'Local, reachable, and accountable',
        ].map((li, i) => (
          <li class="reveal panel flex items-center gap-3 p-4 text-sm text-text" style={`--reveal-delay:${i * 45}ms`}>
            <Icon name="check" class="h-4 w-4 shrink-0 text-jet-hi" /> {li}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBanner heading="Let's make your place the sharpest on the block" />
</BaseLayout>
