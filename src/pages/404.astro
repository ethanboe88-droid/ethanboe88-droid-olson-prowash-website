---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { NAV_LINKS } from '../data/site';
---
<BaseLayout title="Page not found" description="That page doesn't exist." canonical="/404" noindex>
  <section class="section">
    <div class="container-x flex min-h-[55vh] flex-col items-center justify-center text-center">
      <p class="display text-[clamp(4rem,12vw,7rem)] text-jet-grad">404</p>
      <h1 class="display mt-4 text-[clamp(1.5rem,3.5vw,2rem)]">This page got power-washed away</h1>
      <p class="mt-3 max-w-md text-text-dim">The link may be old or mistyped. Try one of these:</p>
      <div class="mt-7 flex flex-wrap justify-center gap-2">
        {NAV_LINKS.map((l) => (
          <a href={l.href} class="rounded-full border border-hairline px-4 py-2 text-sm text-text-dim transition hover:border-jet/60 hover:text-text">{l.label}</a>
        ))}
      </div>
      <a href="/contact#quote" class="btn btn-primary mt-8">Get a Free Quote <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </section>
</BaseLayout>
