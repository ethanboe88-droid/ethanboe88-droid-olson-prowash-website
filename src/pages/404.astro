---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { NAV_LINKS } from '../data/site';
---
<BaseLayout title="Page not found" description="That page doesn’t exist." canonical="/404" noindex>
  <section class="section">
    <div class="container-x flex min-h-[55vh] flex-col items-center justify-center text-center">
      <p class="font-display text-7xl font-extrabold text-gradient sm:text-8xl">404</p>
      <h1 class="mt-4 text-2xl font-bold sm:text-3xl">This page got power-washed away</h1>
      <p class="mt-3 max-w-md text-silver">The link may be old or mistyped. Try one of these instead:</p>
      <div class="mt-7 flex flex-wrap justify-center gap-2">
        {NAV_LINKS.map((l) => (
          <a href={l.href} class="rounded-full border border-ink-line px-4 py-2 text-sm text-silver transition hover:border-electric/60 hover:text-white">{l.label}</a>
        ))}
      </div>
      <a href="/contact#quote" class="btn btn-primary mt-8">Get a Free Quote <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </section>
</BaseLayout>
