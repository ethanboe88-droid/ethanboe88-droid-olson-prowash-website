---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JetDivider from '../components/JetDivider.astro';
import CtaBanner from '../components/CtaBanner.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { breadcrumbLd, webPageLd, localBusinessLd } from '../data/schema';

const platforms = [
  { icon: 'google', label: 'Google', read: SITE.googleBusinessUrl, write: SITE.googleReviewUrl, note: '4.9 ★ · 54+ reviews' },
  { icon: 'yelp', label: 'Yelp', read: SITE.social.yelp, write: SITE.social.yelp, note: 'Read & leave a review' },
  { icon: 'facebook', label: 'Facebook', read: SITE.social.facebook, write: SITE.social.facebook, note: 'Recommendations & photos' },
  { icon: 'nextdoor', label: 'Nextdoor', read: SITE.social.nextdoor, write: SITE.social.nextdoor, note: 'Neighborhood recommendations' },
  { icon: 'yahoo', label: 'Yahoo Local', read: SITE.social.yahoo, write: SITE.social.yahoo, note: 'Listing & reviews' },
].filter((p) => p.read);
---
<BaseLayout
  title="Reviews — What Snohomish & King County Homeowners Say | Olson Pro Wash"
  description="Read real Olson Pro Wash reviews from homeowners and businesses across Lake Stevens, Snohomish & King County — 4.9★ on Google, plus Yelp, Facebook and Nextdoor."
  canonical="/reviews"
  keywords="Olson Pro Wash reviews, pressure washing reviews Lake Stevens WA, roof cleaning reviews Snohomish County, best rated pressure washer near me"
  jsonLd={[
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews' }]),
    webPageLd({
      name: 'Reviews — Olson Pro Wash',
      description: 'Customer reviews and ratings for Olson Pro Wash across Snohomish & King County, WA.',
      path: '/reviews',
      speakableSelectors: ['h1', 'section:nth-of-type(1) p'],
    }),
    localBusinessLd,
  ]}
>
  <PageHero
    eyebrow="Reviews"
    title="Rated <span class='text-jet-grad'>4.9 stars</span> by the neighborhood"
    intro="Real reviews from homeowners, HOAs and businesses across Snohomish and North King County. Live from Google below — and on every platform we're listed."
    crumbs={[{ label: 'Reviews' }]}
  />

  <section class="section">
    <div class="container-x">
      <div class="reveal panel flex flex-wrap items-center justify-between gap-6 p-6 sm:p-8">
        <div class="flex items-center gap-4">
          <div class="flex text-jet-hi" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-6 w-6" />)}
          </div>
          <div>
            <div class="font-display text-2xl font-extrabold text-text">4.9<span class="text-text-mute">/5</span></div>
            <div class="text-xs text-text-mute">54+ reviews across Google, Yelp, Facebook &amp; Nextdoor</div>
          </div>
        </div>
        <a href={SITE.googleReviewUrl} target="_blank" rel="noopener" class="btn btn-primary">
          Leave a review <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-x">
      <SectionHeading eyebrow="Live from Google" title="What customers are saying" />
      <div class="mt-10"><GoogleReviews /></div>
    </div>
  </section>

  <JetDivider />

  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="Everywhere we're listed" title="Read us — and review us — on any platform" />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {platforms.map((p) => (
          <a href={p.read} target="_blank" rel="noopener" class="reveal panel lift group flex items-start gap-4 p-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi group-hover:text-text"><Icon name={p.icon} class="h-5 w-5" /></span>
            <span class="min-w-0">
              <span class="block font-display text-sm font-bold text-text">{p.label}</span>
              <span class="mt-0.5 block text-xs text-text-dim">{p.note}</span>
              <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-jet-hi">Open <Icon name="arrow" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-x">
      <div class="reveal panel p-6 sm:p-8">
        <span class="eyebrow">Why it matters to us</span>
        <p class="mt-3 max-w-2xl text-lg leading-relaxed text-text-dim">
          Our mission is simple — do honest work, and take care of everybody in our community. Reviews
          are how we know we're holding that line, and how a neighbor two streets over decides whether to
          trust us with their home. If we've worked for you, a few words on Google mean a lot.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={SITE.googleReviewUrl} target="_blank" rel="noopener" class="btn btn-primary text-sm"><Icon name="google" class="h-4 w-4" /> Review us on Google</a>
          <a href="/work" class="btn btn-ghost text-sm">See the work <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner heading="Join the list of happy neighbors" sub={`Free, itemized quotes across Snohomish & King County. Call ${SITE.phone} or send a couple of photos.`} />
</BaseLayout>
