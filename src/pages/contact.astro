---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import QuoteForm from '../components/QuoteForm.astro';
import HousecallProWidget from '../components/HousecallProWidget.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { breadcrumbLd, webPageLd } from '../data/schema';
---
<BaseLayout
  title="Contact & Free Quote"
  description={`Request a free pressure washing, roof cleaning or landscaping quote from Olson Pro Wash. Call ${SITE.phone}. Serving Lake Stevens & Snohomish County, WA.`}
  canonical="/contact"
  jsonLd={[
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }]),
    webPageLd({
      type: 'ContactPage',
      name: 'Contact & Free Quote — Olson Pro Wash',
      description: `Request a free quote or call ${SITE.phone}. Serving Lake Stevens, Snohomish & King County, WA.`,
      path: '/contact',
      speakableSelectors: ['h1', 'h2'],
    }),
  ]}
>
  <PageHero
    eyebrow="Contact"
    title="Get a free quote"
    intro="Tell us about your property and what's bugging you about it. Most estimates come back the same day — no sales pressure, ever."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <QuoteForm />

      <div class="space-y-5">
        <div class="panel p-6">
          <h2 class="font-display text-lg font-bold text-text">Talk to a human</h2>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a href={SITE.phoneHref} class="flex items-center gap-3 text-text hover:text-jet-hi">
              <span class="grid h-10 w-10 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name="phone" class="h-5 w-5" /></span>
              <span><span class="block font-semibold">{SITE.phone}</span><span class="text-xs text-text-mute">Mon–Thu 9a–12a · Fri–Sun 10a–12a</span></span>
            </a></li>
            <li><a href={SITE.emailHref} class="flex items-center gap-3 text-text hover:text-jet-hi">
              <span class="grid h-10 w-10 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name="mail" class="h-5 w-5" /></span>
              <span><span class="block font-semibold">{SITE.email}</span><span class="text-xs text-text-mute">We reply within one business day</span></span>
            </a></li>
            <li class="flex items-center gap-3 text-text">
              <span class="grid h-10 w-10 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name="pin" class="h-5 w-5" /></span>
              <span><span class="block font-semibold">{SITE.address.locality}, {SITE.address.region}</span><span class="text-xs text-text-mute">{SITE.areaServedLong}</span></span>
            </li>
          </ul>
          <a href={SITE.googleBusinessUrl} target="_blank" rel="noopener" class="btn btn-ghost mt-5 w-full text-sm"><Icon name="google" class="h-4 w-4" /> View us on Google</a>
          <a href={SITE.googleReviewUrl} target="_blank" rel="noopener" class="btn btn-ghost mt-2 w-full text-sm"><Icon name="star" class="h-4 w-4" /> Leave a Google review</a>

          <p class="mt-5 text-xs font-semibold uppercase tracking-eyebrow text-text-mute">Find us on</p>
          <div class="mt-3 flex flex-wrap gap-2.5">
            {[
              { href: SITE.social.facebook, icon: 'facebook', label: 'Facebook' },
              { href: SITE.social.instagram, icon: 'instagram', label: 'Instagram' },
              { href: SITE.social.yelp, icon: 'yelp', label: 'Yelp' },
              { href: SITE.social.nextdoor, icon: 'nextdoor', label: 'Nextdoor' },
              { href: SITE.social.yahoo, icon: 'yahoo', label: 'Yahoo Local' },
            ].filter((s) => s.href).map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}
                 class="grid h-10 w-10 place-items-center rounded-xl border border-hairline text-text-dim transition hover:border-jet/60 hover:text-text">
                <Icon name={s.icon} class="h-5 w-5" />
              </a>
            ))}
          </div>
        </div>

        <div class="panel p-6">
          <h2 class="font-display text-lg font-bold text-text">Business hours</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {SITE.hours.map((h) => (
              <li class="flex items-center justify-between border-b border-hairline pb-2 text-text-dim">
                <span>{h.days}</span><span class="font-medium text-text">{h.close ? `${h.open} – ${h.close}` : h.open}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <HousecallProWidget heading="Rather just book a time?" sub="Skip the form — pick a service and slot in the Housecall Pro scheduler below." />

  <section class="section border-t border-hairline">
    <div class="container-x">
      <SectionHeading eyebrow="Reviews" title="What the neighbors say" intro="Live from our Google Business Profile." />
      <div class="mt-10"><GoogleReviews /></div>
    </div>
  </section>

  <section class="section bg-ink-1/50">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Service area" title="Serving <span class='text-jet-grad'>Lake Stevens, Snohomish &amp; King County</span>" intro="Based in Lake Stevens and covering the surrounding communities. If your town isn't listed, ask anyway — we travel for the right project." />
        <ul class="mt-8 flex flex-wrap gap-2">
          {SITE.serviceCities.map((c) => (
            <li class="rounded-full border border-hairline bg-white/[0.03] px-3.5 py-1.5 text-sm text-text-dim">{c}, {SITE.address.region}</li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#quote" data-magnetic class="btn btn-primary">Check my address <Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/service-area" class="btn btn-ghost">See all cities we serve</a>
        </div>
      </div>
      <div class="reveal bezel overflow-hidden rounded-2xl">
        {/* Swap for an embedded Google Map iframe when ready. */}
        <img src="/images/service-area-map.svg" alt="Map of the Lake Stevens, Snohomish and King County service area" class="aspect-[7/5] w-full object-cover" loading="lazy" width="1400" height="1000" />
      </div>
    </div>
  </section>
</BaseLayout>
