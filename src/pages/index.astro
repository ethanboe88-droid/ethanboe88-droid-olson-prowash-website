---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import JetDivider from '../components/JetDivider.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BentoServices from '../components/BentoServices.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import StatStrip from '../components/StatStrip.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HousecallProWidget from '../components/HousecallProWidget.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { localBusinessLd, websiteLd, faqLd, personLd, webPageLd } from '../data/schema';

const homeFaqs = [
  {
    q: 'How much does pressure washing cost in the Lake Stevens area?',
    a: 'Most residential projects land between $99 and $700 depending on size, surface and buildup. House washes are priced by square footage and stories; roofs by slope area and moss coverage; flatwork by area. You get an itemized, no-obligation quote before anything is booked.',
  },
  {
    q: 'Will you pressure wash my roof or soft wash it?',
    a: 'Our recommended method is a <strong>low-pressure soft wash</strong> — professional biocides that kill moss and algae at the root, then a full rinse. It is what ARMA and the shingle manufacturers call for; high pressure strips granules and voids most warranties. A lower-cost budget powder treatment is also available.',
  },
  {
    q: 'Are you licensed and insured?',
    a: 'Yes — Olson Landscaping Pro Wash LLC is licensed and carries general liability coverage. We provide a certificate of insurance for commercial, HOA and property-management work.',
  },
  {
    q: 'What areas do you serve?',
    a: `We serve ${SITE.areaServed} and the wider Snohomish &amp; North King County region — ${SITE.serviceCities.slice(0, 8).join(', ')} and nearby. Not sure if you're in range? Just ask.`,
  },
  {
    q: 'Will the detergents hurt my plants or pets?',
    a: 'No. We pre-wet and rinse landscaping, use biodegradable products at safe dilutions, and follow a plant-protection protocol on every soft wash. Pets are fine once surfaces have dried.',
  },
];
---
<BaseLayout
  title={`${SITE.name} — Pressure Washing & Roof Cleaning in ${SITE.address.locality}, ${SITE.address.region}`}
  description="Premium pressure washing, roof & soft washing, house washing and landscaping in Lake Stevens, WA. Serving Snohomish & King County. Licensed & insured."
  canonical="/"
  preloadImage="/images/hero.jpg"
  keywords="pressure washing Lake Stevens WA, roof cleaning Lake Stevens, moss removal, soft washing, house washing, gutter cleaning, gutter guards, Snohomish County, King County, Olson Pro Wash"
  jsonLd={[
    localBusinessLd,
    websiteLd,
    personLd,
    webPageLd({
      name: `${SITE.name} — Pressure Washing & Roof Cleaning in ${SITE.address.locality}, ${SITE.address.region}`,
      description: SITE.description,
      path: '/',
      image: '/images/hero.jpg',
      speakableSelectors: ['h1', '.eyebrow'],
    }),
    faqLd(homeFaqs),
  ]}
>
  <Hero />

  <!-- Services (bento) -->
  <section id="services" class="section scroll-mt-24">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="What we do"
          title="Every exterior surface, <span class='text-jet-grad'>engineered clean</span>"
          intro="One crew for the whole property — from a moss-choked roof to the flower beds. Every service calibrated to the surface it's cleaning."
        />
        <a href="/services" class="btn btn-ghost reveal">All services <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-12"><BentoServices /></div>
    </div>
  </section>

  <JetDivider />

  <!-- Before / After -->
  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading
        eyebrow="See the difference"
        title="Drag to blast off the <span class='text-jet-grad'>before</span>"
        intro="Real results from real Snohomish and King County properties. No filters — just the right method and a crew that doesn't cut corners."
      />
      <div class="mt-12">
        <BeforeAfter class="reveal" before="/images/roof-before.jpg" after="/images/roof-after.jpg" start="54"
          label="Roof soft wash · Snohomish County, WA" beforeAlt="Roof covered in moss and black streaks before soft washing"
          afterAlt="Same roof after soft washing — moss and streaks gone" />
      </div>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { src: '/images/p-house.jpg', cap: 'House wash · Lake Stevens', alt: 'Technician soft-washing a two-story home' },
          { src: '/images/p-driveway.jpg', cap: 'Driveway · Marysville', alt: 'Rotary surface cleaner on a concrete driveway' },
          { src: '/images/p-deck.jpg', cap: 'Composite deck · Snohomish', alt: 'Soft-washing a composite deck' },
        ].map((p, i) => (
          <figure class="reveal bezel overflow-hidden rounded-2xl bg-ink-2" style={`--reveal-delay:${i * 70}ms`}>
            <Photo src={p.src} alt={p.alt} width={1500} height={1000}
                   sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                   class="aspect-[3/2] w-full object-cover" />
            <figcaption class="border-t border-hairline px-4 py-2.5 text-xs text-text-mute">{p.cap}, WA</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <JetDivider flip />

  <!-- Stats -->
  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow="By the numbers" title="Pressure you can <span class='text-jet-grad'>measure</span>" class="mb-10" />
      <StatStrip />
    </div>
  </section>

  <!-- Why us -->
  <section class="section bg-ink-1/50">
    <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <SectionHeading
          eyebrow="Why Olson"
          title="The details are the <span class='text-jet-grad'>whole job</span>"
          intro="Anyone can point a wand at a wall. A premium result comes from prep, chemistry, pressure control and clean-up — done the same way every time."
        />
        <a href="/guarantee" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi link-underline">
          See the full guarantee <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          { icon: 'drop', t: 'Right method, right surface', d: 'Soft wash for roofs and siding, hot pressure for hardscapes. We never blast what should be bathed.' },
          { icon: 'shield', t: 'Licensed, insured, uniformed', d: 'A real company with a COI on file, not a truck and a trailer that disappears.' },
          { icon: 'leaf', t: 'Landscape protection protocol', d: 'Beds pre-wet, plants rinsed, biodegradable products at safe dilution.' },
          { icon: 'tag', t: 'The quote is the price', d: 'Itemized estimates. The number we say is the number you pay.' },
          { icon: 'star', t: 'Photo-documented results', d: 'Before/after photos on every commercial job and any residential job you want them on.' },
          { icon: 'check', t: 'Satisfaction guarantee', d: 'If a spot gets missed, we come back. No drama.' },
        ].map((f, i) => (
          <div class="reveal panel p-5" style={`--reveal-delay:${i * 55}ms`}>
            <span class="grid h-10 w-10 place-items-center rounded-lg border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={f.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-[15px] font-bold text-text">{f.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-dim">{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Google Reviews -->
  <section class="section">
    <div class="container-x">
      <SectionHeading
        eyebrow="Reviews"
        title="Neighbors who <span class='text-jet-grad'>don't hold back</span>"
        intro="Live from our Google Business Profile — real reviews from homeowners and businesses across Snohomish and King County."
      />
      <a href="/reviews" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi link-underline">
        All reviews &amp; where to find us <Icon name="arrow" class="h-4 w-4" />
      </a>
      <div class="mt-10"><GoogleReviews /></div>
    </div>
  </section>

  <HousecallProWidget />

  <JetDivider />

  <!-- FAQ -->
  <section class="section bg-ink-1/50">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <SectionHeading eyebrow="Good to know" title="Questions, answered" />
        <a href="/faq" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-jet-hi link-underline">
          See all FAQs <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
