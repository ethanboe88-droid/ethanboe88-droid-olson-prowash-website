---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import { SERVICES } from '../data/services';
import { SITE } from '../data/site';
import { breadcrumbLd, serviceLd, faqLd, howToLd, webPageLd } from '../data/schema';

const processSteps = [
  { n: '01', t: 'Quote', d: 'Send photos or book a walk-through. Same-day estimate, itemized, no pressure.' },
  { n: '02', t: 'Schedule', d: 'Pick a date online or by phone. We confirm crew and arrival window.' },
  { n: '03', t: 'Prep & protect', d: 'Cover outlets and fixtures, pre-wet landscaping, move furniture.' },
  { n: '04', t: 'Clean & rinse', d: 'Correct method per surface, full rinse-down, walk the job with you.' },
];

const serviceFaqs = [
  { q: 'How long does a typical house wash take?', a: 'Most single-family homes take 2–4 hours start to finish, including setup and clean-up. Larger or multi-story homes may run a half day.' },
  { q: 'Do I need to be home?', a: 'Not necessarily. As long as we have water access and a way to reach gated areas, many customers are at work while we clean. We text before and after.' },
  { q: 'Can you get moss out of the gutters and off the roof in one visit?', a: 'Yes — roof soft wash, moss treatment and a full gutter clean-out are commonly bundled into a single appointment at a lower combined rate.' },
  { q: 'Do you offer recurring maintenance plans?', a: 'Yes — quarterly, semi-annual and annual plans for homes and commercial properties, at a lower per-visit rate than one-off cleans.' },
];
---
<BaseLayout
  title="Services — Roof Cleaning, Pressure Washing, Gutter Guards & Landscaping"
  description={`Roof cleaning, house washing, pressure & soft washing, gutter cleaning, gutter guard installation, deck, driveway, commercial exterior maintenance and landscaping across Snohomish & King County, WA. Licensed & insured.`}
  canonical="/services"
  keywords="pressure washing services Snohomish County, roof cleaning, soft washing, house washing, gutter cleaning, gutter guard installation, deck cleaning, driveway cleaning, commercial pressure washing, Lake Stevens WA"
  jsonLd={[
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }]),
    webPageLd({
      type: 'CollectionPage',
      name: 'Services — Olson Pro Wash',
      description: 'Roof cleaning, house washing, pressure & soft washing, gutter cleaning, gutter guards, deck, driveway, commercial and landscaping.',
      path: '/services',
    }),
    ...SERVICES.map(serviceLd),
    howToLd({
      name: 'How an Olson Pro Wash exterior cleaning job works',
      description: 'The four steps from quote to finished, damage-free clean.',
      path: '/services',
      steps: processSteps.map((s) => ({ name: s.t, text: s.d })),
    }),
    faqLd(serviceFaqs),
  ]}
>
  <PageHero
    eyebrow="Services"
    title="Every exterior surface, <span class='text-jet-grad'>handled</span>"
    intro="From a full roof soft wash to a season-long commercial maintenance plan. Here's exactly what each service covers — and how we do it without causing damage."
    crumbs={[{ label: 'Services' }]}
  />

  <div class="sticky top-[76px] z-30 border-b border-hairline bg-ink/80 backdrop-blur">
    <div class="container-x flex gap-2 overflow-x-auto py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {SERVICES.map((s) => (
        <a href={s.detailPage ?? `#${s.slug}`} class="inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-hairline px-3.5 py-1.5 text-xs font-medium text-text-dim transition hover:border-jet/60 hover:text-text">{s.title}{s.detailPage && <Icon name="arrow" class="h-3 w-3" />}</a>
      ))}
    </div>
  </div>

  <div class="section">
    <div class="container-x space-y-20 lg:space-y-28">
      {SERVICES.map((s, i) => (
        <article id={s.slug} class="scroll-mt-32">
          <div class="grid items-start gap-10 lg:grid-cols-2">
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <span class="inline-flex items-center gap-2.5">
                <span class="grid h-11 w-11 place-items-center rounded-xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={s.icon} class="h-6 w-6" /></span>
                <span class="eyebrow">Service {String(i + 1).padStart(2, '0')}</span>
              </span>
              <h2 class="display reveal mt-4 text-[clamp(1.8rem,4.4vw,2.6rem)]">{s.title}</h2>
              <p class="reveal mt-4 text-lg leading-relaxed text-text-dim">{s.description}</p>
              <ul class="reveal mt-6 grid gap-2.5 sm:grid-cols-2">
                {s.benefits.map((b) => (
                  <li class="flex items-start gap-2.5 text-sm text-text-mute">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-jet-hi" /><span set:html={b} />
                  </li>
                ))}
              </ul>
              <div class="reveal mt-7 flex flex-wrap items-center gap-3">
                {s.detailPage ? (
                  <a href={s.detailPage} data-magnetic class="btn btn-primary">Explore {s.title} <Icon name="arrow" class="h-4 w-4" /></a>
                ) : (
                  <a href="/contact#quote" data-magnetic class="btn btn-primary">Quote this service <Icon name="arrow" class="h-4 w-4" /></a>
                )}
                <span class="font-display text-xs font-semibold uppercase tracking-eyebrow text-text-mute">{s.price}</span>
              </div>
            </div>
            <div class:list={['reveal', i % 2 === 1 && 'lg:order-1']}>
              {s.slug === 'roof-cleaning' ? (
                <BeforeAfter before="/images/roof-before.jpg" after="/images/roof-after.jpg" start={54}
                  label="Roof soft wash — before / after" beforeAlt="Mossy roof before soft washing" afterAlt="Clean roof after soft washing" />
              ) : s.photo ? (
                <figure class="bezel overflow-hidden rounded-2xl bg-ink-2">
                  <Photo src={s.photo} alt={s.photoAlt ?? `${s.title} by Olson Pro Wash`} width={1500} height={1000}
                         sizes="(min-width: 1024px) 560px, 100vw" class="aspect-[3/2] w-full object-cover" />
                  <figcaption class="border-t border-hairline px-4 py-3 text-xs text-text-mute">{s.title} · Snohomish County, WA</figcaption>
                </figure>
              ) : (
                <div class="bezel relative grid aspect-[3/2] place-items-center overflow-hidden rounded-2xl bg-ink-2 text-center">
                  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.12]" style="background: var(--jet-gradient); background-size: 220% 100%;"></div>
                  <div class="relative">
                    <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name={s.icon} class="h-7 w-7" /></span>
                    <p class="mt-4 font-display text-sm font-semibold uppercase tracking-eyebrow text-text-mute">{s.title}</p>
                    <p class="mt-1 text-xs text-text-mute">Project photos coming soon</p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <section class="section bg-ink-1/50">
    <div class="container-x">
      <SectionHeading eyebrow="How it works" title="Four steps, <span class='text-jet-grad'>zero surprises</span>" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((p, i) => (
          <div id={`step-${i + 1}`} class="reveal panel scroll-mt-28 p-6" style={`--reveal-delay:${i * 70}ms`}>
            <div class="font-display text-2xl font-extrabold text-jet/40">{p.n}</div>
            <h3 class="mt-3 font-display text-lg font-bold text-text">{p.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-dim">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading eyebrow="Service FAQ" title="Before you book" />
      <Faq items={serviceFaqs} />
    </div>
  </section>

  <CtaBanner heading="Not sure which service you need?" sub="Send a couple photos — we'll tell you the right method and a ballpark price, free." />
</BaseLayout>
