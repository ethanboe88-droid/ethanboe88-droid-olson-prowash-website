---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import IconSprite from '../components/IconSprite.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  /** LCP image to preload (e.g. the hero photo) */
  preloadImage?: string;
  /** override the meta keywords hint */
  keywords?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = SITE.ogImage,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  preloadImage,
  keywords,
} = Astro.props;

// Keep meta/OG descriptions within the ~160-char range search engines display.
// Templates should already be concise; this is a safety clamp at a word boundary.
const metaDescription =
  description.length <= 160
    ? description
    : description.slice(0, 157).replace(/\s+\S*$/, '') + '…';

const siteUrl = Astro.site ?? new URL(SITE.domain);
// One canonical URL form everywhere: absolute, no trailing slash (root stays "/").
// Matches the sitemap and every internal link, so there are no duplicate-URL signals.
const canonicalPath = new URL(canonical, siteUrl);
canonicalPath.pathname = canonicalPath.pathname.replace(/(.+)\/$/, '$1');
const canonicalUrl = canonicalPath.href;
const ogImage = new URL(image, siteUrl).href;
const ogImageAlt =
  imageAlt ?? `${SITE.name} — exterior cleaning in ${SITE.address.locality}, ${SITE.address.region}`;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-us" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}
    {keywords && <meta name="keywords" content={keywords} />}

    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={SITE.legalName} />
    <meta name="publisher" content={SITE.legalName} />
    <meta name="geo.region" content={`US-${SITE.address.region}`} />
    <meta name="geo.placename" content={SITE.address.locality} />
    <meta name="geo.position" content={`${SITE.geo.latitude};${SITE.geo.longitude}`} />
    <meta name="ICBM" content={`${SITE.geo.latitude}, ${SITE.geo.longitude}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Journal`} href="/rss.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={`${preloadImage.replace(/\.jpg$/i, '-800.avif')} 800w, ${preloadImage.replace(/\.jpg$/i, '.avif')} 1400w`}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}

    {/* Display face (hero headline) preloaded at normal priority — a swap here is the
       most visible. Body face preloaded at low priority: it starts early on the many
       text-hero pages without out-competing the LCP image on pages that have one. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin fetchpriority="low" />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    <ViewTransitions />
  </head>

  <body class="min-h-dvh">
    <IconSprite />
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-jet focus:px-4 focus:py-2 focus:font-display focus:text-sm focus:text-white">
      Skip to content
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <LeadModal />

    <script is:inline>
      // Global interactions. Called on first load + after every ClientRouter nav.
      (function () {
        if (window.__olsonGlobalBound) return;
        window.__olsonGlobalBound = true;

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

        function initReveal() {
          var els = Array.prototype.slice.call(document.querySelectorAll('.reveal:not([data-reveal-done])'));
          if (!els.length) return;
          els.forEach(function (el) { el.setAttribute('data-reveal-done', '1'); });

          if (reduce || !('IntersectionObserver' in window)) return;

          els.forEach(function (el) { el.classList.add('pre-reveal'); });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
          els.forEach(function (el) { io.observe(el); });

          // fail-safe for throttled/embedded webviews
          setTimeout(function () {
            var anyIn = els.some(function (el) { return el.classList.contains('is-in'); });
            if (!anyIn) els.forEach(function (el) { el.classList.remove('pre-reveal'); });
          }, 1600);
        }

        function initCounters() {
          var nums = Array.prototype.slice.call(document.querySelectorAll('[data-count]:not([data-count-done])'));
          if (!nums.length || !('IntersectionObserver' in window)) {
            nums.forEach(function (n) {
              n.setAttribute('data-count-done', '1');
              var v = parseFloat(n.getAttribute('data-count'));
              n.textContent = (n.getAttribute('data-prefix') || '') + v.toLocaleString() + (n.getAttribute('data-suffix') || '');
            });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              var n = e.target;
              io.unobserve(n);
              n.setAttribute('data-count-done', '1');
              var target = parseFloat(n.getAttribute('data-count'));
              var pre = n.getAttribute('data-prefix') || '';
              var suf = n.getAttribute('data-suffix') || '';
              var gauge = n.closest('[data-gauge]') ? n.closest('[data-gauge]').querySelector('.gauge-needle') : null;
              var max = gauge ? parseFloat(gauge.getAttribute('data-max')) : target;
              if (reduce) {
                n.textContent = pre + target.toLocaleString() + suf;
                if (gauge) gauge.style.transform = 'rotate(' + (-120 + 240 * (target / max)) + 'deg)';
                return;
              }
              var start = performance.now();
              var dur = 1400;
              (function tick(now) {
                var p = Math.min(1, (now - start) / dur);
                var eased = easeOutCubic(p);
                var val = target < 10 ? Math.round(target * eased * 10) / 10 : Math.round(target * eased);
                n.textContent = pre + val.toLocaleString() + suf;
                if (gauge) gauge.style.transform = 'rotate(' + (-120 + 240 * ((target * eased) / max)) + 'deg)';
                if (p < 1) requestAnimationFrame(tick);
              })(start);
            });
          }, { threshold: 0.4 });
          nums.forEach(function (n) { io.observe(n); });
        }

        function initHeader() {
          var header = document.getElementById('site-header');
          if (!header) return;
          var onScroll = function () { header.classList.toggle('is-scrolled', window.scrollY > 12); };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        function initMagnetic() {
          if (reduce || window.matchMedia('(pointer: coarse)').matches) return;
          document.querySelectorAll('[data-magnetic]:not([data-magnetic-done])').forEach(function (el) {
            el.setAttribute('data-magnetic-done', '1');
            el.style.willChange = 'transform';
            el.addEventListener('pointermove', function (e) {
              var r = el.getBoundingClientRect();
              var x = (e.clientX - r.left - r.width / 2) * 0.22;
              var y = (e.clientY - r.top - r.height / 2) * 0.22;
              el.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
            });
            el.addEventListener('pointerleave', function () { el.style.transform = ''; });
          });
        }

        function initYear() {
          document.querySelectorAll('[data-year]').forEach(function (el) {
            el.textContent = String(new Date().getFullYear());
          });
        }

        function boot() { initReveal(); initCounters(); initMagnetic(); initYear(); }

        initHeader();
        boot();
        document.addEventListener('astro:page-load', boot);
      })();
    </script>
  </body>
</html>
