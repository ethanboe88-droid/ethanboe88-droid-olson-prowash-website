---
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { TESTIMONIALS } from '../data/testimonials';
interface Props { heading?: string; }
const { heading } = Astro.props;
const items = TESTIMONIALS;
---
<div class="reveal" data-carousel>
  {heading && <h3 class="sr-only">{heading}</h3>}
  <div class="relative">
    <div class="carousel-track flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
         aria-live="polite">
      {items.map((t) => (
        <figure class="panel w-[85%] shrink-0 snap-center p-7 sm:w-[420px] sm:p-8">
          <Icon name="quote" class="h-8 w-8 text-jet/40" />
          <blockquote class="mt-4 text-[15px] leading-relaxed text-text/90"><p set:html={t.quote} /></blockquote>
          <figcaption class="mt-6 flex items-center justify-between border-t border-hairline pt-5">
            <div>
              <div class="font-display text-sm font-semibold text-text" set:html={t.name} />
              <div class="text-xs text-text-mute">{t.location} · {t.service}</div>
            </div>
            <Stars rating={t.rating} />
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-6 flex items-center justify-between">
      <div class="carousel-dots flex gap-2" role="tablist" aria-label="Testimonials">
        {items.map((_, i) => (
          <button class="h-2 w-2 rounded-full bg-white/20 transition-all data-[active]:w-6 data-[active]:bg-jet-hi" data-dot={i} aria-label={`Go to testimonial ${i + 1}`}></button>
        ))}
      </div>
      <div class="flex gap-2">
        <button class="carousel-play grid h-10 w-10 place-items-center rounded-full border border-hairline text-text transition hover:border-jet/60 hover:bg-white/5" aria-label="Pause autoplay" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="carousel-icon-pause h-4 w-4" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          <svg viewBox="0 0 24 24" class="carousel-icon-play hidden h-4 w-4" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <button class="carousel-prev grid h-10 w-10 place-items-center rounded-full border border-hairline text-text transition hover:border-jet/60 hover:bg-white/5" aria-label="Previous testimonial"><Icon name="chevronLeft" class="h-5 w-5" /></button>
        <button class="carousel-next grid h-10 w-10 place-items-center rounded-full border border-hairline text-text transition hover:border-jet/60 hover:bg-white/5" aria-label="Next testimonial"><Icon name="chevronRight" class="h-5 w-5" /></button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function initCarousel(root) {
      if (root.dataset.carouselReady) return;
      root.dataset.carouselReady = '1';
      var track = root.querySelector('.carousel-track');
      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
      var prev = root.querySelector('.carousel-prev');
      var next = root.querySelector('.carousel-next');
      var playBtn = root.querySelector('.carousel-play');
      if (!track) return;
      var slides = Array.prototype.slice.call(track.children);
      var index = 0;
      var timer = null;
      var onscreen = true;
      var paused = false;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      function setDots() { for (var i = 0; i < dots.length; i++) dots[i].toggleAttribute('data-active', i === index); }
      function go(i) {
        index = (i + slides.length) % slides.length;
        var t = slides[index];
        track.scrollTo({ left: t.offsetLeft - (track.clientWidth - t.clientWidth) / 2, behavior: reduce.matches ? 'auto' : 'smooth' });
        setDots();
      }
      function sync() {
        var c = track.scrollLeft + track.clientWidth / 2, best = 0, bd = Infinity;
        for (var i = 0; i < slides.length; i++) {
          var sc = slides[i].offsetLeft + slides[i].clientWidth / 2;
          var d = Math.abs(sc - c);
          if (d < bd) { bd = d; best = i; }
        }
        index = best; setDots();
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() {
        stop();
        if (reduce.matches || paused || !onscreen || document.hidden) return;
        timer = setInterval(function () { go(index + 1); }, 6000);
      }
      function setPaused(p) {
        paused = p;
        if (playBtn) {
          playBtn.setAttribute('aria-pressed', String(p));
          playBtn.setAttribute('aria-label', p ? 'Play autoplay' : 'Pause autoplay');
          playBtn.querySelector('.carousel-icon-pause').classList.toggle('hidden', p);
          playBtn.querySelector('.carousel-icon-play').classList.toggle('hidden', !p);
        }
        start();
      }

      if (prev) prev.addEventListener('click', function () { go(index - 1); });
      if (next) next.addEventListener('click', function () { go(index + 1); });
      if (playBtn) playBtn.addEventListener('click', function () { setPaused(!paused); });
      dots.forEach(function (d, di) { d.addEventListener('click', function () { go(di); }); });
      track.addEventListener('scroll', function () { requestAnimationFrame(sync); }, { passive: true });
      root.addEventListener('pointerenter', stop);
      root.addEventListener('pointerleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
      reduce.addEventListener('change', function () { reduce.matches ? stop() : start(); });

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (e) { onscreen = e[0].isIntersecting; onscreen ? start() : stop(); }, { threshold: 0.2 });
        io.observe(root);
      }
      setDots();
      start();
    }
    function boot() { document.querySelectorAll('[data-carousel]').forEach(initCarousel); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('astro:page-load', boot);
  })();
</script>
