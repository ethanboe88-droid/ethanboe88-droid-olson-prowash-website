---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
interface Props {
  service: Service;
  index?: number;
  href?: string;
}
const { service, index = 0, href = `/services#${service.slug}` } = Astro.props;
---
<a
  href={href}
  id={service.slug}
  class="card card-hover reveal group flex scroll-mt-28 flex-col p-6 sm:p-7"
  style={`--reveal-delay:${(index % 3) * 90}ms`}
>
  <span class="relative grid h-12 w-12 place-items-center rounded-xl border border-ink-line bg-white/[0.03] text-electric-300 transition-colors group-hover:border-electric/50 group-hover:text-white">
    <span class="absolute inset-0 rounded-xl bg-electric/15 opacity-0 blur-md transition-opacity group-hover:opacity-100"></span>
    <Icon name={service.icon} class="relative h-6 w-6" />
  </span>

  <h3 class="mt-5 font-display text-xl font-bold text-white">{service.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-silver">{service.short}</p>

  <ul class="mt-4 space-y-1.5">
    {service.bullets.slice(0, 3).map((b) => (
      <li class="flex items-start gap-2 text-sm text-silver-muted">
        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-electric-300" />
        <span set:html={b} />
      </li>
    ))}
  </ul>

  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-electric-300">
    Learn more
    <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
</a>
