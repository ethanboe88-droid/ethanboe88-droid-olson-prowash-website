---
// Before/after comparison. Pointer drag with momentum, keyboard, touch-safe.
interface Props {
  before: string;
  after: string;
  beforeAlt?: string;
  afterAlt?: string;
  label?: string;
  start?: number;
  class?: string;
}
const {
  before, after,
  beforeAlt = 'Before cleaning', afterAlt = 'After cleaning',
  label, start = 55, class: className = '',
} = Astro.props;

// Serve avif/webp when the source is a processed .jpg photo (variants exist).
const modern = (src: string, ext: string) =>
  src.replace(/\.jpg$/i, `-800.${ext}`) + ' 800w, ' + src.replace(/\.jpg$/i, `.${ext}`) + ' 1600w';
const isJpg = (s: string) => /\.jpg$/i.test(s);
const baSizes = '(min-width: 1024px) 600px, 100vw';
---
<figure class:list={['ba group relative select-none overflow-hidden rounded-2xl border border-hairline bg-ink-2', className]}>
  <div class="ba-view relative aspect-[16/10] w-full" style="touch-action: pan-y;">
    <picture>
      {isJpg(after) && <source type="image/avif" srcset={modern(after, 'avif')} sizes={baSizes} />}
      {isJpg(after) && <source type="image/webp" srcset={modern(after, 'webp')} sizes={baSizes} />}
      <img src={after} alt={afterAlt} loading="lazy" decoding="async" width="1600" height="1000"
           class="absolute inset-0 h-full w-full object-cover" />
    </picture>
    <div class="ba-clip absolute inset-0 overflow-hidden" style={`width:${start}%`}>
      <picture>
        {isJpg(before) && <source type="image/avif" srcset={modern(before, 'avif')} sizes={baSizes} />}
        {isJpg(before) && <source type="image/webp" srcset={modern(before, 'webp')} sizes={baSizes} />}
        <img src={before} alt={beforeAlt} loading="lazy" decoding="async" width="1600" height="1000"
             class="absolute inset-0 h-full w-full max-w-none object-cover" />
      </picture>
    </div>

    <span class="pointer-events-none absolute left-3 top-3 rounded-md bg-black/55 px-2 py-1 font-display text-[11px] font-semibold uppercase tracking-eyebrow text-white backdrop-blur">Before</span>
    <span class="pointer-events-none absolute right-3 top-3 rounded-md bg-jet/85 px-2 py-1 font-display text-[11px] font-semibold uppercase tracking-eyebrow text-white backdrop-blur">After</span>

    <input type="range" class="ba-range absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
           min="0" max="100" value={start}
           aria-label={label ? `${label}: reveal before or after` : 'Reveal before or after'} />

    <!-- Nozzle-grip Jet-Line handle -->
    <div class="ba-handle pointer-events-none absolute inset-y-0 z-10 -ml-px w-[3px]" style={`left:${start}%; background: var(--jet-gradient); background-size: 100% 400%; box-shadow: 0 0 20px rgba(59,159,212,0.7);`}>
      <span class="absolute left-1/2 top-1/2 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-white/70 bg-black/60 backdrop-blur">
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-4 6 4 6M15 6l4 6-4 6"/></svg>
      </span>
    </div>
  </div>
  {label && <figcaption class="border-t border-hairline px-4 py-3 text-sm text-text-mute">{label}</figcaption>}
</figure>

<script is:inline>
  (function () {
    function initBA(el) {
      if (el.dataset.baReady) return;
      el.dataset.baReady = '1';
      var view = el.querySelector('.ba-view');
      var range = el.querySelector('.ba-range');
      var clip = el.querySelector('.ba-clip');
      var handle = el.querySelector('.ba-handle');
      if (!view || !range || !clip || !handle) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var pos = parseFloat(range.value);
      var vel = 0;
      var raf = null;
      var lastX = 0, lastT = 0, dragging = false;

      function apply(p) {
        pos = Math.max(0, Math.min(100, p));
        clip.style.width = pos + '%';
        handle.style.left = pos + '%';
        range.value = String(Math.round(pos));
      }
      apply(pos);

      function pctFromClientX(x) {
        var r = view.getBoundingClientRect();
        return ((x - r.left) / r.width) * 100;
      }

      function decay() {
        vel *= 0.92;
        apply(pos + vel);
        if (Math.abs(vel) > 0.05 && pos > 0 && pos < 100) {
          raf = requestAnimationFrame(decay);
        } else { raf = null; }
      }

      view.addEventListener('pointerdown', function (e) {
        dragging = true;
        if (raf) { cancelAnimationFrame(raf); raf = null; }
        view.setPointerCapture(e.pointerId);
        lastX = e.clientX; lastT = performance.now();
        apply(pctFromClientX(e.clientX));
      });
      view.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var now = performance.now();
        var p = pctFromClientX(e.clientX);
        var dt = now - lastT || 16;
        vel = ((p - pos) / dt) * 16;
        apply(p);
        lastX = e.clientX; lastT = now;
      });
      function release() {
        if (!dragging) return;
        dragging = false;
        if (!reduce && Math.abs(vel) > 0.4) { raf = requestAnimationFrame(decay); }
      }
      view.addEventListener('pointerup', release);
      view.addEventListener('pointercancel', release);

      range.addEventListener('input', function () { apply(parseFloat(range.value)); });
      range.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { apply(pos - 4); e.preventDefault(); }
        if (e.key === 'ArrowRight') { apply(pos + 4); e.preventDefault(); }
      });
    }

    function boot() { document.querySelectorAll('.ba').forEach(initBA); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('astro:page-load', boot);
  })();
</script>
