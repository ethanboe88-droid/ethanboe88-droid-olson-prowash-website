---
// ===========================================================================
//  HOUSECALL PRO - ONLINE BOOKING WIDGET
// ---------------------------------------------------------------------------
//  "Book online" opens the Housecall Pro booking modal (script.js is loaded
//  async, once, on the pages that use this component). If the third-party
//  script is blocked or slow, the button falls back to /contact#quote, and
//  the phone + "Request a quote" link are always available.
//  Token/orgName come from the Housecall Pro > Settings > Online Booking
//  embed snippet.
// ===========================================================================
import Icon from './Icon.astro';
import { SITE } from '../data/site';
interface Props { heading?: string; sub?: string; }
const {
  heading = 'Book online in 60 seconds',
  sub = 'Pick your service and a time that works — no phone tag. Powered by Housecall Pro.',
} = Astro.props;
---
<section id="book" class="section scroll-mt-28">
  <div class="container-x">
    <div class="reveal panel overflow-hidden">
      <div class="grid gap-0 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="border-b border-hairline p-8 sm:p-10 lg:border-b-0 lg:border-r">
          <span class="eyebrow">Instant scheduling</span>
          <h2 class="display mt-4 text-2xl sm:text-3xl">{heading}</h2>
          <p class="mt-3 text-text-dim">{sub}</p>
          <ul class="mt-6 space-y-3 text-sm text-text-mute">
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-jet-hi" /> Live crew availability</li>
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-jet-hi" /> Instant confirmation &amp; reminders</li>
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-jet-hi" /> Reschedule anytime</li>
          </ul>
        </div>
        <div class="p-4 sm:p-6">
          <div class="hcp-embed grid min-h-[320px] place-items-center rounded-xl border border-hairline bg-ink-2/40 p-8 text-center">
            <div>
              <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name="clock" class="h-7 w-7" /></div>
              <p class="mt-4 font-display text-base font-semibold text-text">Reserve your spot online</p>
              <p class="mx-auto mt-1.5 max-w-xs text-xs text-text-mute">Live crew availability, instant confirmation — about a minute start to finish.</p>
              <div class="mt-5 flex flex-col justify-center gap-2 sm:flex-row">
                <button type="button" class="btn btn-primary text-sm" onclick="window.HCPWidget ? HCPWidget.openModal() : (location.href='/contact#quote')">Book online</button>
                <a href={SITE.phoneHref} class="btn btn-ghost text-sm"><Icon name="phone" class="h-4 w-4" /> {SITE.phone}</a>
              </div>
              <a href="/contact#quote" class="mt-3 inline-block text-xs text-text-mute underline-offset-4 transition hover:text-text hover:underline">Prefer to send photos? Request a quote &rarr;</a>
            </div>
          </div>
          {/* Housecall Pro online booking — loads async, only on pages using this component */}
          <script is:inline async src="https://online-booking.housecallpro.com/script.js?token=ddfa1a957ec742288edd7ce506607436&orgName=Olson-Landscaping--Pro-Wash-LLC"></script>
        </div>
      </div>
    </div>
  </div>
</section>
