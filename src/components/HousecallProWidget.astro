---
// ===========================================================================
//  HOUSECALL PRO - ONLINE BOOKING WIDGET  (PLACEHOLDER)
// ---------------------------------------------------------------------------
//  1. Housecall Pro  ->  Settings  ->  "Online Booking". Enable it and copy
//     the embed snippet (a single SCRIPT element with your token / orgName).
//  2. Paste that SCRIPT element inside the ".hcp-embed" div below and add
//     Astro's  is:inline  directive so Astro leaves the third-party tag alone.
//     You can instead place it in src/layouts/BaseLayout.astro before the
//     closing body tag if Housecall Pro says to load it globally.
//  3. Prefer a plain button? Set a bookingUrl in src/data/site.ts and point
//     the fallback links there.
//  Until then, the styled fallback keeps the page finished and routes to the
//  quote form / phone.
// ===========================================================================
import Icon from './Icon.astro';
import { SITE } from '../data/site';
interface Props { heading?: string; sub?: string; }
const {
  heading = 'Book online in 60 seconds',
  sub = 'Pick your service and a time that works — no phone tag. Powered by Housecall Pro.',
} = Astro.props;
---
<section id="book" class="section scroll-mt-28">
  <div class="container-x">
    <div class="reveal panel overflow-hidden">
      <div class="grid gap-0 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="border-b border-hairline p-8 sm:p-10 lg:border-b-0 lg:border-r">
          <span class="eyebrow">Instant scheduling</span>
          <h2 class="display mt-4 text-2xl sm:text-3xl">{heading}</h2>
          <p class="mt-3 text-text-dim">{sub}</p>
          <ul class="mt-6 space-y-3 text-sm text-text-mute">
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-jet-hi" /> Live crew availability</li>
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-jet-hi" /> Instant confirmation &amp; reminders</li>
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-jet-hi" /> Reschedule anytime</li>
          </ul>
        </div>
        <div class="p-4 sm:p-6">
          {/* ===== PASTE HOUSECALL PRO EMBED SNIPPET INSIDE .hcp-embed (add is:inline) ===== */}
          <div class="hcp-embed min-h-[320px] rounded-xl">
            <div class="grid h-full min-h-[320px] place-items-center rounded-xl border border-dashed border-hairline bg-ink-2/60 p-8 text-center">
              <div>
                <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-hairline bg-white/[0.03] text-jet-hi"><Icon name="clock" class="h-7 w-7" /></div>
                <p class="mt-4 font-display text-sm font-semibold text-text">Housecall Pro booking widget loads here</p>
                <p class="mx-auto mt-1.5 max-w-xs text-xs text-text-mute">Developer note: paste the Housecall Pro embed snippet in <code class="rounded bg-white/5 px-1">HousecallProWidget.astro</code>.</p>
                <div class="mt-5 flex flex-col justify-center gap-2 sm:flex-row">
                  <a href="/contact#quote" class="btn btn-primary text-sm">Request a Quote</a>
                  <a href={SITE.phoneHref} class="btn btn-ghost text-sm"><Icon name="phone" class="h-4 w-4" /> {SITE.phone}</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
