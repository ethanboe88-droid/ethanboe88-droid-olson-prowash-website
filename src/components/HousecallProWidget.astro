---
// ===========================================================================
//  HOUSECALL PRO - ONLINE BOOKING WIDGET  (PLACEHOLDER)
// ---------------------------------------------------------------------------
//  To enable real-time online booking:
//
//  1. Housecall Pro  ->  Settings  ->  "Online Booking".
//  2. Turn on online booking and copy the EMBED snippet Housecall Pro gives
//     you. It is a single SCRIPT element that looks roughly like:
//
//       src = https://online-booking.housecallpro.com/script.min.js
//             ?token=YOUR_TOKEN&orgName=olson-pro-wash
//
//  3. Paste that SCRIPT element into the marked spot in the markup below,
//     inside the element with class "hcp-embed". Add Astro's `is:inline`
//     directive to it so Astro leaves the third-party tag untouched.
//
//     You can instead place the same SCRIPT element in
//     src/layouts/BaseLayout.astro, just before the closing body tag, if
//     Housecall Pro tells you to load it globally.
//
//  4. Prefer a plain button over the inline widget? Set `bookingUrl` in
//     src/data/site.ts and point the fallback links there.
//
//  Until the snippet is added, the styled fallback below keeps the page
//  looking finished and routes visitors to the quote form / phone.
// ===========================================================================
import Icon from './Icon.astro';
import { SITE } from '../data/site';

interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = 'Book online in 60 seconds',
  sub = 'Pick your service and a time that works — no phone tag. Powered by Housecall Pro.',
} = Astro.props;
---
<section id="book" class="section scroll-mt-28">
  <div class="container-x">
    <div class="reveal card overflow-hidden">
      <div class="grid gap-0 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="border-b border-ink-line p-8 sm:p-10 lg:border-b-0 lg:border-r">
          <span class="kicker">Instant Scheduling</span>
          <h2 class="mt-4 text-2xl font-bold sm:text-3xl">{heading}</h2>
          <p class="mt-3 text-silver">{sub}</p>
          <ul class="mt-6 space-y-3 text-sm text-silver-muted">
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-electric-300" /> Live crew availability</li>
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-electric-300" /> Instant confirmation &amp; reminders</li>
            <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-electric-300" /> Reschedule anytime</li>
          </ul>
        </div>

        <div class="p-4 sm:p-6">
          {/* ============================================================= */}
          {/*  PASTE HOUSECALL PRO EMBED INSIDE .hcp-embed BELOW.          */}
          {/*  Add the Housecall Pro booking SCRIPT element here and give   */}
          {/*  it the  is:inline  directive. See file header for steps.    */}
          {/* ============================================================= */}
          <div class="hcp-embed min-h-[320px] rounded-xl">
            {/* --- Fallback shown until the embed is added ----------------- */}
            <div class="grid h-full min-h-[320px] place-items-center rounded-xl border border-dashed border-ink-line bg-ink-raised/60 p-8 text-center">
              <div>
                <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-ink-line bg-white/[0.03] text-electric-300">
                  <Icon name="clock" class="h-7 w-7" />
                </div>
                <p class="mt-4 font-display text-sm font-semibold text-white">
                  Housecall Pro booking widget loads here
                </p>
                <p class="mx-auto mt-1.5 max-w-xs text-xs text-silver-dim">
                  Developer note: paste the Housecall Pro embed snippet in
                  <code class="rounded bg-white/5 px-1">HousecallProWidget.astro</code>.
                </p>
                <div class="mt-5 flex flex-col justify-center gap-2 sm:flex-row">
                  <a href="/contact#quote" class="btn btn-primary text-sm">Request a Quote</a>
                  <a href={SITE.phoneHref} class="btn btn-ghost text-sm">
                    <Icon name="phone" class="h-4 w-4" /> {SITE.phone}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
