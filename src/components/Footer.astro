---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, NAV_LINKS } from '../data/site';
import { SERVICES } from '../data/services';
---
<footer class="relative mt-24 border-t border-hairline bg-ink-1">
  <div class="jet-divider"></div>
  <div class="container-x py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <Logo variant="footer" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-text-dim">
          {SITE.legalName}. Premium pressure washing, roof &amp; soft washing, and landscaping.
          {SITE.areaServedLong}.
        </p>
        <div class="mt-5 flex flex-wrap gap-2.5">
          {[
            { href: SITE.social.facebook, icon: 'facebook', label: 'Facebook' },
            { href: SITE.social.instagram, icon: 'instagram', label: 'Instagram' },
            { href: SITE.social.yelp, icon: 'yelp', label: 'Yelp' },
            { href: SITE.social.nextdoor, icon: 'nextdoor', label: 'Nextdoor' },
            { href: SITE.social.yahoo, icon: 'yahoo', label: 'Yahoo Local' },
            { href: SITE.googleBusinessUrl, icon: 'google', label: 'Google Business Profile' },
          ].filter((s) => s.href).map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}
               class="grid h-10 w-10 place-items-center rounded-xl border border-hairline text-text-dim transition hover:border-jet/60 hover:text-text">
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-eyebrow text-text">Company</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {NAV_LINKS.map((l) => (
            <li><a href={l.href} class="inline-block py-1 text-text-dim transition hover:text-text link-underline">{l.label}</a></li>
          ))}
          <li><a href="/work" class="inline-block py-1 text-text-dim transition hover:text-text link-underline">Our Work</a></li>
          <li><a href="/reviews" class="inline-block py-1 text-text-dim transition hover:text-text link-underline">Reviews</a></li>
          <li><a href="/guarantee" class="inline-block py-1 text-text-dim transition hover:text-text link-underline">Guarantee</a></li>
          <li><a href="/faq" class="inline-block py-1 text-text-dim transition hover:text-text link-underline">FAQ</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-eyebrow text-text">Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {SERVICES.slice(0, 6).map((s) => (
            <li><a href={s.detailPage ?? `/services#${s.slug}`} class="inline-block py-1 text-text-dim transition hover:text-text link-underline">{s.title}</a></li>
          ))}
          <li><a href="/services/maintenance-plans" class="inline-block py-1 text-text-dim transition hover:text-text link-underline">Maintenance Plans</a></li>
          <li><a href="/services" class="inline-block py-1 font-medium text-jet-hi transition hover:text-text link-underline">All services →</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-eyebrow text-text">Get in touch</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href={SITE.phoneHref} class="flex items-center gap-2.5 text-text-dim transition hover:text-text"><Icon name="phone" class="h-4 w-4 text-jet-hi" /> {SITE.phone}</a></li>
          <li><a href={SITE.emailHref} class="flex items-center gap-2.5 text-text-dim transition hover:text-text"><Icon name="mail" class="h-4 w-4 text-jet-hi" /> {SITE.email}</a></li>
          <li class="flex items-center gap-2.5 text-text-dim"><Icon name="pin" class="h-4 w-4 text-jet-hi" /> {SITE.address.locality}, {SITE.address.region}</li>
          <li class="flex items-start gap-2.5 text-text-dim">
            <Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-jet-hi" />
            <span>{SITE.hours.map((h) => (<span class="block">{h.days}: {h.close ? `${h.open}–${h.close}` : h.open}</span>))}</span>
          </li>
        </ul>
        <a href="/contact#quote" class="btn btn-primary mt-5 w-full text-sm">Get a Free Quote</a>
      </div>
    </div>

    <div class="jet-divider my-10"></div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-text-mute sm:flex-row">
      <p>© <span data-year>2026</span> {SITE.legalName}. All rights reserved.</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>Licensed &amp; Insured in Washington</span>
        <a href="/blog" class="inline-block py-1 hover:text-text link-underline">Journal</a>
        <a href="/service-area" class="inline-block py-1 hover:text-text link-underline">Service Area</a>
        <a href="/faq" class="inline-block py-1 hover:text-text link-underline">FAQ</a>
      </p>
    </div>
  </div>
</footer>
