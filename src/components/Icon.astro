const d = paths[name] ?? paths.drop;
const brand = ['facebook', 'instagram', 'google', 'yelp', 'nextdoor', 'yahoo'].includes(name);
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill={brand ? 'currentColor' : 'none'}
  stroke={brand ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  set:html={(title ? `<title>${title}</title>` : '') + d}
/>
