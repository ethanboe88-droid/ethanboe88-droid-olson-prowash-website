---
// Renders a <use> reference to the IconSprite (one <symbol> per icon, emitted
// once in BaseLayout). Falls back to the `drop` icon for an unknown name.
import { ICON_PATHS } from '../data/icons';
interface Props { name: string; class?: string; title?: string; }
const { name, class: className = 'h-6 w-6', title } = Astro.props;
const id = ICON_PATHS[name] ? name : 'drop';
---
<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  <use href={`#i-${id}`} />
</svg>
