---
interface Props { rating?: number; class?: string; }
const { rating = 5, class: className = 'h-4 w-4' } = Astro.props;
const full = Math.round(rating);
---
<span class="inline-flex items-center gap-0.5 text-jet-hi" role="img" aria-label={`${rating} out of 5 stars`}>
  {Array.from({ length: 5 }).map((_, i) => (
    <svg class={className} viewBox="0 0 24 24" fill={i < full ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="m12 3 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.2l1-5.8L3.5 9.2l5.9-.9L12 3Z" />
    </svg>
  ))}
</span>
