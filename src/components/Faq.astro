---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; class?: string; }
const { items, class: className = '' } = Astro.props;
---
<div class:list={['divide-y divide-hairline overflow-hidden rounded-2xl border border-hairline', className]}>
  {items.map((item, i) => (
    <details class="group reveal bg-ink-1" style={`--reveal-delay:${i * 55}ms`} name="faq">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display text-[15px] font-semibold text-text sm:p-6 [&::-webkit-details-marker]:hidden">
        {item.q}
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-hairline text-jet-hi transition-transform duration-300 group-open:rotate-45">
          <Icon name="plus" class="h-4 w-4" />
        </span>
      </summary>
      <div class="px-5 pb-6 text-sm leading-relaxed text-text-dim sm:px-6"><p set:html={item.a} /></div>
    </details>
  ))}
</div>
