---
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import TrustBar from './TrustBar.astro';
import { SITE } from '../data/site';

const words = ['Driveways.', 'Siding.', 'Roofs.', 'Decks.', 'Storefronts.'];
---
<section class="relative isolate overflow-hidden">
  <!-- Animated gradient field -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-1/4 -top-1/3 h-[80vh] w-[80vh] rounded-full bg-electric/20 blur-[120px] animate-float"></div>
    <div class="absolute -right-1/4 top-1/4 h-[60vh] w-[60vh] rounded-full bg-electric-300/15 blur-[120px] animate-float [animation-delay:-3s]"></div>
    <div class="absolute inset-0 bg-brand-gradient bg-[length:220%_auto] opacity-[0.10] animate-gradient-pan"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent,rgba(10,10,10,0.4)_60%,#0a0a0a)]"></div>
  </div>

  <div class="container-x grid items-center gap-12 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:pb-24 lg:pt-24">
    <div>
      <p class="kicker animate-fade-up">{SITE.areaServedLong}</p>

      <h1 class="mt-5 text-[2.6rem] font-extrabold leading-[1.02] tracking-tightest sm:text-6xl lg:text-[4.25rem]">
        <span class="block animate-fade-up [animation-delay:60ms]">We make it look</span>
        <span class="block animate-fade-up text-gradient [animation-delay:140ms]">brand&nbsp;new again.</span>
        <span class="mt-3 block h-[1.15em] overflow-hidden text-2xl font-bold text-silver sm:text-3xl">
          <span id="hero-rotator" class="inline-block will-change-transform">{words[0]}</span>
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-silver animate-fade-up [animation-delay:220ms]">
        Olson Pro Wash is Northwest Wisconsin’s premium exterior cleaning &amp; landscaping crew.
        Hot-water pressure washing, gentle soft washing, and a finish-work eye that treats your
        property like our own.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row animate-fade-up [animation-delay:300ms]">
        <a href="/contact#quote" class="btn btn-primary">
          Get a Free Quote <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="#book" class="btn btn-ghost">
          <Icon name="clock" class="h-4 w-4" /> Book Online
        </a>
      </div>

      <div class="mt-8 flex items-center gap-3 animate-fade-up [animation-delay:360ms]">
        <Stars rating={5} class="h-5 w-5" />
        <span class="text-sm text-silver">
          <span class="font-semibold text-white">4.9/5</span> from local homeowners &amp; businesses
        </span>
      </div>

      <TrustBar class="mt-8 animate-fade-up [animation-delay:420ms]" />
    </div>

    <!-- Visual: framed before/after tease -->
    <div class="relative animate-fade-up [animation-delay:200ms]">
      <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-electric/10 blur-2xl"></div>
      <div class="overflow-hidden rounded-[1.75rem] border border-ink-line bg-ink-raised shadow-card">
        <div class="relative aspect-[4/5] w-full">
          <img src="/images/after-1.svg" alt="Freshly soft-washed home exterior" class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" width="1600" height="1000" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5">
            <div class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-black/45 p-3 backdrop-blur">
              <div>
                <div class="text-[11px] uppercase tracking-widest text-silver-muted">Same-day transformation</div>
                <div class="font-display text-sm font-semibold text-white">House wash · Spooner, WI</div>
              </div>
              <a href="/gallery" class="btn btn-primary !px-4 !py-2 text-xs">See the gallery</a>
            </div>
          </div>
        </div>
      </div>
      <div class="absolute -right-3 -top-3 hidden rotate-3 rounded-xl border border-ink-line bg-ink-soft px-3 py-2 text-xs font-semibold text-white shadow-glow-sm sm:block">
        <span class="text-electric-300">◆</span> Licensed &amp; Insured
      </div>
    </div>
  </div>
</section>

<script define:vars={{ words }}>
  const el = document.getElementById('hero-rotator');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % words.length;
      el.animate(
        [
          { transform: 'translateY(0)', opacity: 1 },
          { transform: 'translateY(-100%)', opacity: 0, offset: 0.5 },
          { transform: 'translateY(60%)', opacity: 0, offset: 0.5 },
          { transform: 'translateY(0)', opacity: 1 },
        ],
        { duration: 620, easing: 'cubic-bezier(0.16,1,0.3,1)' }
      );
      setTimeout(() => (el.textContent = words[i]), 310);
    }, 2400);
  }
</script>
