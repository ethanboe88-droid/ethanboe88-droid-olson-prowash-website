---
import Icon from './Icon.astro';
import Photo from './Photo.astro';

export type Shot = { src: string; cat: string; alt: string };
interface Props { shots: Shot[]; }
const { shots } = Astro.props;
const cats = ['All', ...Array.from(new Set(shots.map((s) => s.cat)))];
---
<div>
  <div id="gallery-filter" class="reveal mb-8 flex flex-wrap gap-2">
    {cats.map((c, i) => (
      <button
        data-filter={c}
        class:list={[
          'rounded-full border px-3.5 py-2 text-xs font-medium transition',
          i === 0 ? 'border-jet/60 bg-jet/10 text-text' : 'border-hairline text-text-dim hover:border-jet/60 hover:text-text',
        ]}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >{c}</button>
    ))}
  </div>

  <div id="masonry" class="gap-4 [column-fill:_balance] sm:columns-2 lg:columns-3">
    {shots.map((s, i) => (
      <button
        class="masonry-item reveal mb-4 block w-full break-inside-avoid overflow-hidden rounded-2xl border border-hairline bg-ink-2 text-left"
        data-cat={s.cat} data-index={i} style={`--reveal-delay:${(i % 3) * 70}ms`}
        aria-label={`Open image: ${s.alt}`}
      >
        <Photo src={s.src} alt={s.alt} width={1500} height={1050}
               sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
               class="w-full object-cover transition-transform duration-500 hover:scale-[1.03]" />
        <span class="flex items-center justify-between px-4 py-3 text-xs">
          <span class="font-display font-semibold uppercase tracking-eyebrow text-text">{s.cat}</span>
          <span class="text-text-mute">Olson Pro Wash</span>
        </span>
      </button>
    ))}
  </div>
</div>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[160] hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm" aria-hidden="true">
  <div class="relative max-h-[88vh] w-full max-w-4xl" role="dialog" aria-modal="true" aria-label="Image viewer">
    <img id="lightbox-img" src="" alt="" class="mx-auto max-h-[82vh] w-auto max-w-full rounded-xl border border-hairline" width="1600" height="1200" />
    <p id="lightbox-cap" class="mt-3 text-center text-sm text-text-dim"></p>
    <button id="lightbox-close" class="absolute -top-2 right-0 grid h-10 w-10 place-items-center rounded-full border border-hairline bg-ink-1 text-text hover:border-jet/60" aria-label="Close"><Icon name="close" class="h-5 w-5" /></button>
    <button id="lightbox-prev" class="absolute left-2 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-hairline bg-ink-1/80 text-text hover:border-jet/60 sm:-left-14" aria-label="Previous image"><Icon name="chevronLeft" class="h-6 w-6" /></button>
    <button id="lightbox-next" class="absolute right-2 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-hairline bg-ink-1/80 text-text hover:border-jet/60 sm:-right-14" aria-label="Next image"><Icon name="chevronRight" class="h-6 w-6" /></button>
  </div>
</div>

<script is:inline define:vars={{ shots }}>
  (function () {
    function boot() {
      var filter = document.getElementById('gallery-filter');
      var items = Array.prototype.slice.call(document.querySelectorAll('.masonry-item'));
      var box = document.getElementById('lightbox');
      if (!filter || !box || box.dataset.ready) return;
      box.dataset.ready = '1';

      var img = document.getElementById('lightbox-img');
      var cap = document.getElementById('lightbox-cap');
      var current = 0;
      var visible = shots.map(function (_, i) { return i; });
      var lastFocus = null;

      // filtering
      var btns = filter.querySelectorAll('[data-filter]');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var val = btn.getAttribute('data-filter');
          btns.forEach(function (b) {
            var on = b === btn;
            b.setAttribute('aria-pressed', String(on));
            b.classList.toggle('border-jet/60', on);
            b.classList.toggle('bg-jet/10', on);
            b.classList.toggle('text-text', on);
            b.classList.toggle('text-text-dim', !on);
          });
          visible = [];
          items.forEach(function (it, i) {
            var show = val === 'All' || it.getAttribute('data-cat') === val;
            it.style.display = show ? '' : 'none';
            if (show) visible.push(i);
          });
        });
      });

      function show(idx) {
        current = (idx + shots.length) % shots.length;
        var s = shots[current];
        var base = s.src.replace(/\.jpg$/i, '');
        img.src = s.src;
        img.srcset = base + '-800.webp 800w, ' + base + '.webp 1500w';
        img.sizes = '(min-width: 1024px) 900px, 100vw';
        img.alt = s.alt;
        cap.textContent = s.cat + ' — ' + s.alt;
      }
      function step(dir) {
        var vi = visible.indexOf(current);
        if (vi === -1) vi = 0;
        show(visible[(vi + dir + visible.length) % visible.length]);
      }
      function open(i) {
        lastFocus = document.activeElement;
        show(i);
        box.classList.remove('hidden');
        box.classList.add('flex');
        box.setAttribute('aria-hidden', 'false');
        document.getElementById('lightbox-close').focus();
        document.addEventListener('keydown', onKey);
      }
      function close() {
        box.classList.add('hidden');
        box.classList.remove('flex');
        box.setAttribute('aria-hidden', 'true');
        document.removeEventListener('keydown', onKey);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      function onKey(e) {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
      }

      items.forEach(function (it) {
        it.addEventListener('click', function () { open(parseInt(it.getAttribute('data-index'), 10)); });
      });
      document.getElementById('lightbox-close').addEventListener('click', close);
      document.getElementById('lightbox-prev').addEventListener('click', function () { step(-1); });
      document.getElementById('lightbox-next').addEventListener('click', function () { step(1); });
      box.addEventListener('click', function (e) { if (e.target === box) close(); });

      // swipe
      var sx = 0;
      box.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
      box.addEventListener('touchend', function (e) {
        var dx = e.changedTouches[0].clientX - sx;
        if (Math.abs(dx) > 45) step(dx < 0 ? 1 : -1);
      }, { passive: true });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('astro:page-load', boot);
  })();
</script>
