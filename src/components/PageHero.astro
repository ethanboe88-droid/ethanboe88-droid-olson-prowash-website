---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: { label: string; href?: string }[];
}
const { eyebrow, title, intro, crumbs = [] } = Astro.props;
---
<section class="relative isolate overflow-hidden border-b border-hairline">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-[42vh] w-[75vw] -translate-x-1/2 rounded-full bg-jet/15 blur-[120px]"></div>
  </div>
  <div class="container-x py-16 sm:py-20 lg:py-24">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-text-mute">
        <ol class="flex flex-wrap items-center gap-x-1.5">
          <li><a href="/" class="inline-block py-1 hover:text-text">Home</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-1.5">
              <span>/</span>
              {c.href ? <a href={c.href} class="inline-block py-1 hover:text-text">{c.label}</a> : <span class="py-1 text-text-dim">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="display mt-4 max-w-3xl text-[clamp(2.4rem,6vw,4rem)]">
      <Fragment set:html={title} />
    </h1>
    {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-dim">{intro}</p>}
  </div>
</section>
