---
// Brand logo. Raster at /public/images/logo.png (transparent bg, keyed from
// the supplied artwork). Wide crest at /public/images/logo-wordmark.png for the footer.
import { SITE } from '../data/site';
interface Props { variant?: 'header' | 'footer'; class?: string; }
const { variant = 'header', class: className = '' } = Astro.props;
const src = variant === 'footer' ? '/images/logo-wordmark.png' : '/images/logo.png';
const size = variant === 'footer' ? 'h-16 w-auto sm:h-20' : 'h-12 w-auto sm:h-[52px]';
---
<span class={`inline-flex items-center ${className}`}>
  <img
    src={src}
    alt={`${SITE.legalName} logo`}
    class={`${size} object-contain [filter:drop-shadow(0_2px_14px_rgba(59,159,212,0.32))]`}
    width={variant === 'footer' ? 320 : 168}
    height={variant === 'footer' ? 92 : 56}
    loading="eager"
    decoding="async"
  />
</span>
