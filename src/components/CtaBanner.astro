---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
interface Props { heading?: string; sub?: string; }
const {
  heading = 'Ready for the cleanest your property has ever looked?',
  sub = 'Free, no-pressure quotes. Most estimates back the same day.',
} = Astro.props;
---
<section class="section">
  <div class="container-x">
    <div class="reveal bezel relative overflow-hidden rounded-4xl p-8 text-center sm:p-14">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-0 opacity-[0.14]" style="background: var(--jet-gradient); background-size:220% 100%;" ></div>
        <div class="absolute inset-0" style="background: radial-gradient(60% 60% at 50% 0%, rgba(59,159,212,0.22), transparent 70%);"></div>
      </div>
      <h2 class="display mx-auto max-w-2xl text-[clamp(1.8rem,4.4vw,2.6rem)]">{heading}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-text-dim">{sub}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/contact#quote" data-magnetic class="btn btn-primary w-full sm:w-auto">Get a Free Quote <Icon name="arrow" class="h-4 w-4" /></a>
        <a href={SITE.phoneHref} class="btn btn-ghost w-full sm:w-auto"><Icon name="phone" class="h-4 w-4" /> Call {SITE.phone}</a>
      </div>
    </div>
  </div>
</section>
