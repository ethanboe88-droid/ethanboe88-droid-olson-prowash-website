---
interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
  class?: string;
}
const { kicker, title, intro, align = 'left', as = 'h2', class: className = '' } = Astro.props;
const Tag = as;
---
<div
  class:list={[
    'reveal max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {kicker && <span class="kicker">{kicker}</span>}
  <Tag class="mt-4 text-balance text-3xl font-bold sm:text-4xl md:text-[2.75rem]">
    <Fragment set:html={title} />
  </Tag>
  {intro && <p class="mt-4 text-lg leading-relaxed text-silver">{intro}</p>}
</div>
