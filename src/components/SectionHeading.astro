---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
  class?: string;
}
const { eyebrow, title, intro, align = 'left', as = 'h2', class: className = '' } = Astro.props;
const Tag = as;
---
<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag class="display mt-4 text-[clamp(1.9rem,4.6vw,2.9rem)]">
    <Fragment set:html={title} />
  </Tag>
  {intro && <p class="mt-4 text-lg leading-relaxed text-text-dim">{intro}</p>}
</div>
